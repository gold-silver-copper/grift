; The editor, in grift. The host (main.rs) gives it bytes and files only:
;   (key)                  the next byte typed, as an integer
;   (term-write s ...)     strings to the terminal, shown when the next key is read
;   (term-size)            (rows columns)
;   (read-file path)       the file's text, () if it doesn't exist
;   (write-file path s)    replaces the file with the string's bytes
;   (string->codes s) (codes->string codes) (string->symbol s) (value->string v)
;   (read-string s)        the forms in s, read, not evaluated
; The host starts the editor with (editor-main file message) and, after an error stopped a
; command, goes on with (editor-recover message). C-g while a command runs interrupts it.
; Everything else is here: the buffer, redisplay, keys and keymaps, the minibuffer, the
; commands. It is evaluated at top level, so every name here can be redefined while the editor
; runs, with M-: or an init file.

; --- Helpers the library doesn't have ---------------------------------------------------------

; The top-level environment, where the editor's state lives.
($define! editor-env (get-current-environment))

($define! <=? ($lambda (a b) (not? (<? b a))))

; (reverse-onto xs ys): xs reversed, in front of ys.
($define! reverse-onto
  ($lambda (xs ys) ($if (null? xs) ys (reverse-onto (cdr xs) (cons (car xs) ys)))))

($define! take
  ($lambda (xs n)
    ($if ($or? (null? xs) (<? n 1)) () (cons (car xs) (take (cdr xs) (- n 1))))))

($define! drop ($lambda (xs n) ($if ($or? (null? xs) (<? n 1)) xs (drop (cdr xs) (- n 1)))))

($define! make-list
  ($lambda (n x) ($if (<? n 1) () (cons x (make-list (- n 1) x)))))

($define! string-length ($lambda (s) (length (string->codes s))))

($define! string-append
  ($lambda strings (codes->string (apply append (map string->codes strings)))))

; (string-join strings separator)
($define! string-join
  ($lambda (strings sep)
    ($if (null? strings)
      ""
      (apply string-append
        (cons (car strings) (apply append (map ($lambda (s) (list sep s)) (cdr strings))))))))

($define! number->string
  ($lambda (n)
    ($define! digits
      ($lambda (n acc)
        ($if (<? n 10)
          (cons (+ 48 n) acc)
          (digits (div n 10) (cons (+ 48 (mod n 10)) acc)))))
    (codes->string ($if (<? n 0) (cons 45 (digits (- 0 n) ())) (digits n ())))))

; (split-codes codes c): the runs of codes between each c, as lists.
($define! split-codes
  ($lambda (codes c)
    ($define! loop
      ($lambda (cs run runs)
        ($if (null? cs)
          (reverse (cons (reverse run) runs))
          ($if (eq? (car cs) c)
            (loop (cdr cs) () (cons (reverse run) runs))
            (loop (cdr cs) (cons (car cs) run) runs)))))
    (loop codes () ())))

; The text of a file as its lines, without the newlines: "a\nb\n" is ("a" "b" "").
($define! text->lines
  ($lambda (text) (map codes->string (split-codes (string->codes text) 10))))

($define! csi "\x1b;[")

; --- Buffers ------------------------------------------------------------------------------------
; A buffer is an environment holding its fields. Point splits the current line into `before`
; (nearest first) and `after`, both lists of code points; the other lines are strings, `above`
; nearest first and `below`. `row` is the current line's number from 0, `top` the first line
; in the window. `keymap` is the buffer's own keymap, looked up before the global one. `undo`
; lists the states before each change, latest first.

($define! make-buffer
  ($lambda (name file lines)
    ($define! b (make-environment))
    (bind! b ($quote (name file above before after below row top keymap modified undo))
      (list name file () () (string->codes (car lines)) (cdr lines) 0 0 (make-environment) #f ()))
    b))

; ($field buffer name), ($b name), ($b! name value): the fields of a buffer and of the current
; buffer.
($define! $field ($vau (b name) env (eval name (eval b env))))
($define! $b ($vau (name) #ignore (eval name current-buffer)))
($define! $b! ($vau (name value) env (bind! current-buffer name (eval value env))))

($define! buffer-line ($lambda (b) (codes->string (reverse-onto ($field b before) ($field b after)))))
($define! line-string ($lambda () (buffer-line current-buffer)))
($define! current-column ($lambda () (length ($b before))))

; Makes `s` the current line with point at column `col`, or at its end if it is shorter.
($define! enter-line
  ($lambda (s col)
    ($define! split
      ($lambda (before after n)
        ($if ($or? (=? n 0) (null? after))
          (list before after)
          (split (cons (car after) before) (cdr after) (- n 1)))))
    ($let (((before after) (split () (string->codes s) col)))
      ($b! before before)
      ($b! after after))))

($define! line-down
  ($lambda (col)
    ($b! above (cons (line-string) ($b above)))
    (enter-line (car ($b below)) col)
    ($b! below (cdr ($b below)))
    ($b! row (+ ($b row) 1))))

($define! line-up
  ($lambda (col)
    ($b! below (cons (line-string) ($b below)))
    (enter-line (car ($b above)) col)
    ($b! above (cdr ($b above)))
    ($b! row (- ($b row) 1))))

($define! insert-codes
  ($lambda (codes)
    ($when (pair? codes)
      ($if (eq? (car codes) 10)
        (newline)
        ($b! before (cons (car codes) ($b before))))
      (insert-codes (cdr codes)))))

($define! buffer-text
  ($lambda ()
    ($define! lines (reverse-onto ($b above) (cons (line-string) ($b below))))
    ; Joined from the last line back, so each line is copied once.
    ($define! join
      ($lambda (rev acc)
        ($if (null? rev)
          acc
          (join (cdr rev) (reverse-onto (reverse (string->codes (car rev))) (cons 10 acc))))))
    ($define! rev (reverse lines))
    (codes->string (join (cdr rev) (string->codes (car rev))))))

($define! text-changed #f)
($define! set-modified ($lambda () ($b! modified #t) ($set! editor-env text-changed #t)))

; A buffer's state for undo. Lines and line halves are immutable lists and strings, so a state
; shares everything with the buffer and costs five pairs.
($define! buffer-state
  ($lambda (b) (list ($field b above) ($field b before) ($field b after) ($field b below) ($field b row))))

; --- Display ------------------------------------------------------------------------------------

($define! message-text "")
($define! message ($lambda (s) ($set! editor-env message-text s)))

; The buffer in the window, and the minibuffer while one is being read (else ()).
($define! window-buffer ())
($define! current-buffer ())
($define! minibuffer ())

; The columns a character takes on the terminal: 2 for East Asian wide characters and most
; emoji, 1 for the rest. A tab goes to the next multiple of 8.
($define! wide-ranges
  (list (list 4352 4447) (list 11904 42191) (list 44032 55203) (list 63744 64255)
        (list 65072 65103) (list 65280 65376) (list 65504 65510) (list 127744 129791)
        (list 131072 262141)))

($define! char-width
  ($lambda (c)
    ($define! wide?
      ($lambda (ranges)
        ($cond ((null? ranges) #f)
               (($and? (<=? (car (car ranges)) c) (<=? c (car (cdr (car ranges))))) #t)
               (#t (wide? (cdr ranges))))))
    ($if ($and? (<? 4351 c) (wide? wide-ranges)) 2 1)))

; The terminal column after `codes`, written from column 0.
($define! display-column
  ($lambda (codes)
    ($define! loop
      ($lambda (codes col)
        ($if (null? codes)
          col
          (loop (cdr codes)
                ($if (eq? (car codes) 9) (+ col (- 8 (mod col 8))) (+ col (char-width (car codes))))))))
    (loop codes 0)))

($define! goto ($lambda (row col) (term-write csi (number->string row) ";" (number->string col) "H")))

($define! show-row ($lambda (row s) (goto row 1) (term-write csi "2K" s)))

($define! show-rows
  ($lambda (row lines n)
    ($when (<? 0 n)
      (show-row row ($if (null? lines) "" (car lines)))
      (show-rows (+ row 1) ($if (null? lines) () (cdr lines)) (- n 1)))))

($define! mode-line
  ($lambda (b cols)
    ($define! s
      (string-append
        ($if ($field b modified) "-**- " "---- ")
        ($field b name)
        "   L" (number->string (+ ($field b row) 1))
        "   C" (number->string (length ($field b before)))))
    (string-append s (codes->string (make-list (- cols (string-length s)) 32)))))

($define! redisplay
  ($lambda ()
    ($define! (rows cols) (term-size))
    ($define! height (max 1 (- rows 2)))
    ($define! w window-buffer)
    ($define! row ($field w row))
    ; Scroll so the current line is in the window, recentring when it leaves.
    ($when ($or? (<? row ($field w top)) (<=? (+ ($field w top) height) row))
      (bind! w ($quote top) (max 0 (- row (div height 2)))))
    ($define! above-shown (- row ($field w top)))
    ($define! lines
      (reverse-onto (take ($field w above) above-shown)
        (cons (buffer-line w) (take ($field w below) (- height (+ above-shown 1))))))
    (term-write csi "?25l")
    (show-rows 1 lines height)
    (goto (- rows 1) 1)
    (term-write csi "7m" (mode-line w cols) csi "0m")
    ($if (null? minibuffer)
      ($sequence
        (show-row rows message-text)
        (goto (+ above-shown 1)
              (+ (min (display-column (reverse ($field w before))) (- cols 1)) 1)))
      ($sequence
        (show-row rows (string-append ($field minibuffer prompt) (buffer-line minibuffer)))
        (goto rows (+ (display-column (append (string->codes ($field minibuffer prompt))
                                              (reverse ($field minibuffer before))))
                      1))))
    (term-write csi "?25h")))

; --- Keys ---------------------------------------------------------------------------------------
; An event is a code point (an integer) for a character, or a symbol: C-a, M-x, RET, DEL, up...
; The terminal's bytes are decoded here: ESC starts a meta key or an escape sequence, and the
; bytes of a UTF-8 character are put together.

($define! control-key
  ($lambda (b)
    ($cond ((=? b 13) ($quote RET))
           ((=? b 9) ($quote TAB))
           ((=? b 0) ($quote C-SPC))
           ((<? b 27) (string->symbol (string-append "C-" (codes->string (list (+ b 96))))))
           (#t (string->symbol (string-append "C-" (codes->string (list (+ b 64)))))))))

($define! read-utf8
  ($lambda (b)
    ($define! more
      ($lambda (n v) ($if (=? n 0) v (more (- n 1) (+ (* v 64) (- (key) 128))))))
    ($cond ((<? b 192) b)
           ((<? b 224) (more 1 (- b 192)))
           ((<? b 240) (more 2 (- b 224)))
           (#t (more 3 (- b 240))))))

($define! decode-byte
  ($lambda (b)
    ($cond ((<? b 32) (control-key b))
           ((=? b 127) ($quote DEL))
           ((<? b 128) b)
           (#t (read-utf8 b)))))

; The bytes of an escape sequence after ESC [ or ESC O, up to its final byte.
($define! escape-sequences
  (list (list "A" ($quote up)) (list "B" ($quote down)) (list "C" ($quote right))
        (list "D" ($quote left)) (list "H" ($quote home)) (list "F" ($quote end))
        (list "1~" ($quote home)) (list "4~" ($quote end)) (list "3~" ($quote deletechar))
        (list "5~" ($quote prior)) (list "6~" ($quote next))))

($define! read-sequence
  ($lambda (codes)
    ($define! b (key))
    ($if ($and? (<=? 64 b) (<=? b 126))
      ($sequence
        ($define! s (codes->string (reverse (cons b codes))))
        ($define! found
          ($lambda (table)
            ($cond ((null? table) (string->symbol (string-append "ESC-[" s)))
                   ((eq? (car (car table)) s) (car (cdr (car table))))
                   (#t (found (cdr table))))))
        (found escape-sequences))
      (read-sequence (cons b codes)))))

($define! read-event
  ($lambda ()
    ($define! b (key))
    ($if (=? b 27)
      ($sequence
        ($define! b2 (key))
        ($if ($or? (=? b2 91) (=? b2 79))
          (read-sequence ())
          (string->symbol (string-append "M-" (key-name (decode-byte b2))))))
      (decode-byte b))))

($define! key-name
  ($lambda (ev)
    ($cond ((=? 32 ($if (integer? ev) ev 0)) "SPC")
           ((integer? ev) (codes->string (list ev)))
           (#t (value->string ev)))))

($define! key-symbol
  ($lambda (ev) ($if (integer? ev) (string->symbol (codes->string (list ev))) ev)))

($define! keys-description
  ($lambda (events) (string-join (map key-name events) " ")))

; --- Keymaps ------------------------------------------------------------------------------------
; A keymap is an environment binding key symbols to command names (symbols) or to keymaps
; (prefix keys). Commands are looked up by name when run, so redefining one takes effect.

($define! global-map (make-environment))

($define! lookup-key
  ($lambda (map ev)
    ($define! k (key-symbol ev))
    ($if (member? k (bindings map)) (eval k map) #f)))

; (kbd "C-x C-s") is (C-x C-s).
($define! kbd
  ($lambda (s)
    (map ($lambda (codes) (string->symbol (codes->string codes)))
         (split-codes (string->codes s) 32))))

; (define-key map "C-x C-s" ($quote save-buffer))
($define! define-key
  ($lambda (map keys command)
    ($define! walk
      ($lambda (map keys)
        ($if (null? (cdr keys))
          (bind! map (car keys) command)
          ($sequence
            ($define! sub (lookup-key map (car keys)))
            ($when (not? (environment? sub))
              ($define! sub (make-environment))
              (bind! map (car keys) sub))
            (walk sub (cdr keys))))))
    (walk map (kbd keys))))

($define! global-set-key ($lambda (keys command) (define-key global-map keys command)))

; --- The command loop ---------------------------------------------------------------------------

($define! last-command-event ())
($define! this-command ())
($define! last-command ())
($define! exit-flag #f)

; Runs a command. If it changed the text, the buffer's state from before goes on its undo list;
; a run of typed characters is undone as one.
($define! run-command
  ($lambda (command)
    ($define! b current-buffer)
    ($define! state (buffer-state b))
    ($set! editor-env this-command command)
    ($set! editor-env text-changed #f)
    ($if (symbol? command)
      (eval (list command) editor-env)
      (command))
    ($when ($and? text-changed
                  (not? (eq? command ($quote undo)))
                  (not? ($and? (eq? command ($quote self-insert-command))
                               (eq? last-command ($quote self-insert-command)))))
      (bind! b ($quote undo) (cons state ($field b undo))))
    ($set! editor-env text-changed #f)
    ($set! editor-env last-command this-command)))

; Runs the key sequence that starts with event `ev`, looked up in `map`; `keys` are the events
; so far, latest first.
($define! dispatch
  ($lambda (map ev keys)
    ($define! binding (lookup-key map ev))
    ($cond ((environment? binding)
            (message (string-append (keys-description (reverse keys)) "-"))
            (redisplay)
            ($define! next (read-event))
            (message "")
            (dispatch binding next (cons next keys)))
           ((eq? binding #f)
            ($if ($and? (integer? ev) (null? (cdr keys)))
              (run-command ($quote self-insert-command))
              (message (string-append (keys-description (reverse keys)) " is undefined"))))
           (#t (run-command binding)))))

($define! command-step
  ($lambda ()
    (redisplay)
    ($define! ev (read-event))
    (message "")
    ($set! editor-env last-command-event ev)
    (dispatch ($if (eq? (lookup-key ($b keymap) ev) #f) global-map ($b keymap)) ev (list ev))))

; Reads and runs commands until one sets exit-flag.
($define! command-loop
  ($lambda ()
    (command-step)
    ($if exit-flag ($set! editor-env exit-flag #f) (command-loop))))

; --- The minibuffer -----------------------------------------------------------------------------

($define! minibuffer-map (make-environment))

; The buffer and minibuffer come back however the reading ends: with RET, or with an error or
; C-g that goes on to the host.
($define! read-from-minibuffer
  ($lambda (prompt)
    ($define! outer-buffer current-buffer)
    ($define! outer-minibuffer minibuffer)
    ($define! mb (make-buffer "*minibuffer*" () (list "")))
    (bind! mb ($quote (keymap prompt)) (list minibuffer-map prompt))
    ($set! editor-env (minibuffer current-buffer) (list mb mb))
    ($unwind-protect
      ($sequence (command-loop) (line-string))
      ($set! editor-env (current-buffer minibuffer exit-flag) (list outer-buffer outer-minibuffer #f)))))

($define! exit-minibuffer ($lambda () ($set! editor-env exit-flag #t)))

; --- Starting and recovering --------------------------------------------------------------------

($define! find-file-noselect
  ($lambda (file)
    ($define! text ($if (null? file) () (read-file file)))
    (make-buffer ($if (null? file) "*scratch*" file) file
      ($if (null? text) (list "") (text->lines text)))))

($define! quit-flag #f)

($define! editor-main
  ($lambda (file text)
    ($set! editor-env window-buffer (find-file-noselect file))
    ($set! editor-env current-buffer window-buffer)
    (message text)
    (main-loop)))

($define! main-loop
  ($lambda () (command-step) ($if quit-flag #inert (main-loop))))

; After an error stopped a command: the error in the echo area, and on. What a command set
; for a while (the minibuffer) its $unwind-protect has put back.
($define! editor-recover ($lambda (text) (message text) (main-loop)))

; --- Commands -----------------------------------------------------------------------------------

($define! self-insert-command
  ($lambda () ($b! before (cons last-command-event ($b before))) (set-modified)))

($define! newline
  ($lambda ()
    ($b! above (cons (codes->string (reverse ($b before))) ($b above)))
    ($b! before ())
    ($b! row (+ ($b row) 1))
    (set-modified)))

($define! forward-char
  ($lambda ()
    ($cond ((pair? ($b after))
            ($b! before (cons (car ($b after)) ($b before)))
            ($b! after (cdr ($b after))))
           ((pair? ($b below)) (line-down 0))
           (#t (message "End of buffer")))))

($define! backward-char
  ($lambda ()
    ($cond ((pair? ($b before))
            ($b! after (cons (car ($b before)) ($b after)))
            ($b! before (cdr ($b before))))
           ((pair? ($b above)) (line-up 1000000000))
           (#t (message "Beginning of buffer")))))

; The column C-n and C-p aim for: kept while they repeat.
($define! goal-column 0)
($define! set-goal
  ($lambda ()
    ($when (not? (member? last-command ($quote (next-line previous-line))))
      ($set! editor-env goal-column (current-column)))))

($define! next-line
  ($lambda ()
    (set-goal)
    ($if (pair? ($b below)) (line-down goal-column) (message "End of buffer"))))

($define! previous-line
  ($lambda ()
    (set-goal)
    ($if (pair? ($b above)) (line-up goal-column) (message "Beginning of buffer"))))

($define! beginning-of-line
  ($lambda () ($b! after (reverse-onto ($b before) ($b after))) ($b! before ())))

($define! end-of-line
  ($lambda () ($b! before (reverse-onto ($b after) ($b before))) ($b! after ())))

($define! beginning-of-buffer
  ($lambda ()
    ($define! lines (reverse-onto ($b above) (cons (line-string) ($b below))))
    ($b! above ())
    ($b! row 0)
    ($b! below (cdr lines))
    (enter-line (car lines) 0)))

($define! end-of-buffer
  ($lambda ()
    ($define! lines (reverse-onto ($b below) (cons (line-string) ($b above))))
    ($b! row (+ ($b row) (length ($b below))))
    ($b! below ())
    ($b! above (cdr lines))
    ($b! before (reverse (string->codes (car lines))))
    ($b! after ())))

($define! delete-backward-char
  ($lambda ()
    ($cond ((pair? ($b before)) ($b! before (cdr ($b before))) (set-modified))
           ((pair? ($b above))
            ($b! before (reverse (string->codes (car ($b above)))))
            ($b! above (cdr ($b above)))
            ($b! row (- ($b row) 1))
            (set-modified))
           (#t (message "Beginning of buffer")))))

($define! delete-char
  ($lambda ()
    ($cond ((pair? ($b after)) ($b! after (cdr ($b after))) (set-modified))
           ((pair? ($b below))
            ($b! after (string->codes (car ($b below))))
            ($b! below (cdr ($b below)))
            (set-modified))
           (#t (message "End of buffer")))))

; The last killed text, as code points (10 for a newline). Kills in a row add to it.
($define! kill-ring ())

($define! kill-line
  ($lambda ()
    ($define! killed
      ($cond ((pair? ($b after))
              ($define! text ($b after))
              ($b! after ())
              text)
             ((pair? ($b below))
              ($b! after (string->codes (car ($b below))))
              ($b! below (cdr ($b below)))
              (list 10))
             (#t (message "End of buffer") ())))
    ($when (pair? killed)
      ($set! editor-env kill-ring ($if (eq? last-command ($quote kill-line)) (append kill-ring killed) killed))
      (set-modified))))

($define! insert-tab ($lambda () (insert-codes (list 9)) (set-modified)))

($define! yank ($lambda () (insert-codes kill-ring) (set-modified)))

($define! undo
  ($lambda ()
    ($if (null? ($b undo))
      (message "No further undo information")
      ($sequence
        ($define! (above before after below row) (car ($b undo)))
        (bind! current-buffer ($quote (above before after below row undo))
          (list above before after below row (cdr ($b undo))))
        (set-modified)
        (message "Undo")))))

($define! save-buffer
  ($lambda ()
    ($when (null? ($b file))
      ($b! file (read-from-minibuffer "File to save in: "))
      ($b! name ($b file)))
    (write-file ($b file) (buffer-text))
    ($b! modified #f)
    (message (string-append "Wrote " ($b file)))))

($define! save-buffers-kill-emacs
  ($lambda ()
    ($when ($or? (not? ($field window-buffer modified))
                 (equal? (read-from-minibuffer "Modified buffer; quit anyway? (yes or no) ") "yes"))
      ($set! editor-env quit-flag #t))))

($define! keyboard-quit ($lambda () (error ($quote quit))))

($define! recenter ($lambda () (term-write csi "2J") (bind! window-buffer ($quote top) -1000)))

($define! execute-extended-command
  ($lambda () (run-command (string->symbol (read-from-minibuffer "M-x ")))))

($define! eval-expression
  ($lambda ()
    ($define! forms (read-string (read-from-minibuffer "Eval: ")))
    (message (value->string (eval (cons $sequence forms) editor-env)))))

; --- Help ---------------------------------------------------------------------------------------

($define! previous-buffer ())
($define! help-map (make-environment))

; Shows `text` in the *Help* buffer, long lines broken at the window's width; q goes back.
($define! show-help
  ($lambda (text)
    ($define! width (max 10 (car (cdr (term-size)))))
    ($define! wrap
      ($lambda (codes)
        ($if (<? (length codes) (+ width 1))
          (list (codes->string codes))
          (cons (codes->string (take codes width))
                (wrap (drop codes width))))))
    ($define! lines (apply append (map wrap (split-codes (string->codes text) 10))))
    ($define! help (make-buffer "*Help*" () lines))
    (bind! help ($quote keymap) help-map)
    (switch-to help)
    (message "q to go back")))

($define! switch-to
  ($lambda (b)
    ($set! editor-env previous-buffer window-buffer)
    ($set! editor-env window-buffer b)
    ($set! editor-env current-buffer b)))

($define! other-buffer
  ($lambda ()
    ($if (null? previous-buffer) (message "No other buffer") (switch-to previous-buffer))))

($define! describe-function
  ($lambda ()
    ($define! name (read-from-minibuffer "Describe function: "))
    (show-help (string-append name " is " (value->string (eval (string->symbol name) editor-env))))))

; The bindings of `map` under `prefix` (a list of key symbols), as lines.
($define! binding-lines
  ($lambda (keymap prefix)
    (apply append
      (map ($lambda (k)
             ($define! b (eval k keymap))
             ($define! keys (append prefix (list k)))
             ($if (environment? b)
               (binding-lines b keys)
               ($sequence
                 ($define! name (keys-description keys))
                 (list (string-append name (codes->string (make-list (max 1 (- 16 (string-length name))) 32))
                                      (value->string b))))))
           (bindings keymap)))))

($define! describe-bindings
  ($lambda ()
    (show-help (string-join (append (list "Key             Binding" "")
                                    (binding-lines global-map ())
                                    (list "" "In the minibuffer:")
                                    (binding-lines minibuffer-map ()))
                            "\n"))))

($define! describe-key
  ($lambda ()
    (message "Describe key: ")
    (redisplay)
    ($define! describe
      ($lambda (map keys)
        ($define! b (lookup-key map (car keys)))
        ($if (environment? b)
          (describe b (cons (read-event) keys))
          ($sequence
            ($define! name (keys-description (reverse keys)))
            ($cond ((eq? b #f) (message (string-append name " is undefined")))
                   (#t (show-help (string-append name " runs " (value->string b) "\n\n"
                                                 (value->string b) " is "
                                                 (value->string (eval b editor-env))))))))))
    (describe global-map (list (read-event)))))

; --- Bindings -----------------------------------------------------------------------------------

(global-set-key "C-f" ($quote forward-char))
(global-set-key "right" ($quote forward-char))
(global-set-key "C-b" ($quote backward-char))
(global-set-key "left" ($quote backward-char))
(global-set-key "C-n" ($quote next-line))
(global-set-key "down" ($quote next-line))
(global-set-key "C-p" ($quote previous-line))
(global-set-key "up" ($quote previous-line))
(global-set-key "C-a" ($quote beginning-of-line))
(global-set-key "home" ($quote beginning-of-line))
(global-set-key "C-e" ($quote end-of-line))
(global-set-key "end" ($quote end-of-line))
(global-set-key "M-<" ($quote beginning-of-buffer))
(global-set-key "M->" ($quote end-of-buffer))
(global-set-key "RET" ($quote newline))
(global-set-key "C-j" ($quote newline))
(global-set-key "DEL" ($quote delete-backward-char))
(global-set-key "C-d" ($quote delete-char))
(global-set-key "deletechar" ($quote delete-char))
(global-set-key "TAB" ($quote insert-tab))
(global-set-key "C-k" ($quote kill-line))
(global-set-key "C-y" ($quote yank))
(global-set-key "C-_" ($quote undo))
(global-set-key "C-x u" ($quote undo))
(global-set-key "C-g" ($quote keyboard-quit))
(global-set-key "C-l" ($quote recenter))
(global-set-key "C-x C-s" ($quote save-buffer))
(global-set-key "C-x C-c" ($quote save-buffers-kill-emacs))
(global-set-key "C-x b" ($quote other-buffer))
(global-set-key "M-x" ($quote execute-extended-command))
(global-set-key "M-:" ($quote eval-expression))
(global-set-key "C-h f" ($quote describe-function))
(global-set-key "C-h b" ($quote describe-bindings))
(global-set-key "C-h k" ($quote describe-key))
(define-key minibuffer-map "RET" ($quote exit-minibuffer))
(define-key help-map "q" ($quote other-buffer))
