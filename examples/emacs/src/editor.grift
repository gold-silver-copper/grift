; The editor, in grift. The host (main.rs) gives it bytes, files and shell commands only:
;   (key)                          the next byte typed, as an integer; the run waits, the host goes on
;   (job-start command)            runs a shell command beside the editor; the job's number
;   (job-wait job)                 the job's exit status once it ends; the run waits, the host goes on
;   (job-cancel job)               kills the job's command
;   (job-abandon job)              ends the runs waiting for the job, through their cleanups
;   (spawn f)                      calls f as a run of its own, beside this one
;   (quit-editor)                  ends the editor, abandoning whatever waits
;   (temporary-file)               a new path for a temporary file
;   (delete-file path)             removes a file
;   (terminal-write s ...)         strings to the terminal, shown when the next key is read
;   (terminal-size)                (rows columns)
;   (read-file path)               the file's text, () if it doesn't exist
;   (write-file path s)            replaces the file with the string's bytes
; The loop is the host's. It starts the editor with (editor-main file message), then whenever no
; run waits for a key starts a (command-step): every command is a run of its own, so a command that
; waits holds up nothing else. It draws with (redisplay) before each wait, gives what a job did to
; (job-event event) and an error that ended a run to (editor-report message), or (editor-recover
; message) when no other run is reading keys. C-g while a command
; is busy interrupts it. Everything else is here: the buffer, redisplay, keys and keymaps, the minibuffer, the
; commands. It is evaluated at top level, so every name here can be redefined while the editor
; runs, with M-: or an init file.

; --- Helpers the library doesn't have ---------------------------------------------------------

; The top-level context, where the editor's state lives.
(define! editor-context (current-context))

; (reverse-onto xs ys): xs reversed, in front of ys.
(define! reverse-onto
  (lambda! (xs ys) (if! (empty-list? xs) ys (reverse-onto (rest xs) (pair (first xs) ys)))))

(define! take
  (lambda! (xs n)
    (if! (or!? (empty-list? xs) (less-than? n 1)) () (pair (first xs) (take (rest xs) (subtract n 1))))))

(define! drop
  (lambda! (xs n) (if! (or!? (empty-list? xs) (less-than? n 1)) xs (drop (rest xs) (subtract n 1)))))

; A string of n spaces.
(define! spaces
  (lambda! (n) (if! (less-than? n 1) "" (string-append " " (spaces (subtract n 1))))))

; A string's characters as a list of code points, decoding its UTF-8, and the other way.
(define! string-to-code-points
  (lambda! (s)
    (define! end (string-byte-length s))
    ; The low 6 bits of `count` bytes from offset `at`, added to `value`.
    (define! continued
      (lambda! (value at count)
        (if! (same? count 0)
          value
          (continued (add (multiply value 64) (remainder (string-byte s at) 64)) (add at 1) (subtract count 1)))))
    (define! from
      (lambda! (at)
        (if! (same? at end)
          ()
          (let! ((b (string-byte s at)))
            (conditional!
              ((less-than? b 128) (pair b (from (add at 1))))
              ((less-than? b 224) (pair (continued (remainder b 32) (add at 1) 1) (from (add at 2))))
              ((less-than? b 240) (pair (continued (remainder b 16) (add at 1) 2) (from (add at 3))))
              (#true (pair (continued (remainder b 8) (add at 1) 3) (from (add at 4)))))))))
    (from 0)))
(define! code-points-to-string
  (lambda! (code-points) (apply string-append (map code-point-to-string code-points))))

; How many characters a string has: string-byte-length counts bytes.
(define! code-point-count (lambda! (s) (length (string-to-code-points s))))

; (split-code-points code-points c): the runs of code points between each c, as lists.
(define! split-code-points
  (lambda! (code-points c)
    (define! loop
      (lambda! (remaining run runs)
        (if! (empty-list? remaining)
          (reverse (pair (reverse run) runs))
          (if! (same? (first remaining) c)
            (loop (rest remaining) () (pair (reverse run) runs))
            (loop (rest remaining) (pair (first remaining) run) runs)))))
    (loop code-points () ())))

; The text of a file as its lines, without the newlines: "a\nb\n" is ("a" "b" "").
(define! text-to-lines (lambda! (text) (string-split text "\n")))

; A terminal control sequence: ESC [ and s.
(define! control-sequence (lambda! (s) (string-append "\x1b;[" s)))

; --- Buffers ------------------------------------------------------------------------------------
; A buffer is a context holding its fields. Point splits the current line into `before`
; (nearest first) and `after`, both lists of code points; the other lines are strings, `above`
; nearest first and `below`. `row` is the current line's number from 0, `top` the first line
; in the window. `keymap` is the buffer's own keymap, looked up before the global one. `undo`
; lists the states before each change, latest first. (evaluate-in! row b) reads a field.

(define! buffer
  (lambda! (name file lines)
    (define! b (context))
    (bind b (quote! (name file above before after below row top keymap modified undo mode))
      (list name file () () (string-to-code-points (first lines)) (rest lines) 0 0 (context)
            #false () ""))
    b))

; (field! name) and (define-field! name value): a field of the current buffer.
(define! field! (vau! (name) #ignore (evaluate name current-buffer)))
(define! define-field!
  (vau! (name value) caller (bind current-buffer name (evaluate value caller))))

(define! buffer-line
  (lambda! (b)
    (code-points-to-string (reverse-onto (evaluate-in! before b) (evaluate-in! after b)))))
(define! line-string (lambda! () (buffer-line current-buffer)))
(define! current-column (lambda! () (length (field! before))))

; Makes `s` the current line with point at `column`, or at its end if it is shorter.
(define! enter-line
  (lambda! (s column)
    (define! split
      (lambda! (before after n)
        (if! (or!? (same? n 0) (empty-list? after))
          (list before after)
          (split (pair (first after) before) (rest after) (subtract n 1)))))
    (let! (((before after) (split () (string-to-code-points s) column)))
      (define-field! before before)
      (define-field! after after))))

(define! line-down
  (lambda! (column)
    (define-field! above (pair (line-string) (field! above)))
    (enter-line (first (field! below)) column)
    (define-field! below (rest (field! below)))
    (define-field! row (add (field! row) 1))))

(define! line-up
  (lambda! (column)
    (define-field! below (pair (line-string) (field! below)))
    (enter-line (first (field! above)) column)
    (define-field! above (rest (field! above)))
    (define-field! row (subtract (field! row) 1))))

(define! insert-code-points
  (lambda! (code-points)
    (when! (pair? code-points)
      (if! (same? (first code-points) 10)
        (newline)
        (define-field! before (pair (first code-points) (field! before))))
      (insert-code-points (rest code-points)))))

(define! buffer-text
  (lambda! ()
    (string-join (reverse-onto (field! above) (pair (line-string) (field! below))) "\n")))

(define! text-changed #false)
(define! set-modified
  (lambda! () (define-field! modified #true) (bind editor-context (quote! text-changed) #true)))

; A buffer's state for undo. Lines and line halves are immutable lists and strings, so a state
; shares everything with the buffer and costs five pairs.
(define! buffer-state
  (lambda! (b)
    (list (evaluate-in! above b) (evaluate-in! before b) (evaluate-in! after b)
          (evaluate-in! below b) (evaluate-in! row b))))

; --- Display ------------------------------------------------------------------------------------

(define! message-text "")
(define! message (lambda! (s) (bind editor-context (quote! message-text) s)))

; The buffer in the window, and the minibuffer while one is being read (else ()).
(define! window-buffer ())
(define! current-buffer ())
(define! minibuffer ())

; The columns a character takes on the terminal: 2 for East Asian wide characters and most
; emoji, 1 for the rest. A tab goes to the next multiple of 8.
(define! wide-ranges
  (list (list 4352 4447) (list 11904 42191) (list 44032 55203) (list 63744 64255)
        (list 65072 65103) (list 65280 65376) (list 65504 65510) (list 127744 129791)
        (list 131072 262141)))

(define! character-width
  (lambda! (c)
    (define! wide?
      (lambda! (ranges)
        (conditional!
          ((empty-list? ranges) #false)
          ((and!? (less-than-or-equal? (first (first ranges)) c)
                  (less-than-or-equal? c (first (rest (first ranges)))))
           #true)
          (#true (wide? (rest ranges))))))
    (if! (and!? (less-than? 4351 c) (wide? wide-ranges)) 2 1)))

; The terminal column after `code-points`, written from column 0. Columns are never negative,
; so remainder is the tab stop's distance.
(define! display-column
  (lambda! (code-points)
    (define! loop
      (lambda! (code-points column)
        (if! (empty-list? code-points)
          column
          (loop (rest code-points)
                (if! (same? (first code-points) 9)
                  (add column (subtract 8 (remainder column 8)))
                  (add column (character-width (first code-points))))))))
    (loop code-points 0)))

(define! move-cursor
  (lambda! (row column)
    (terminal-write
      (control-sequence (string-append (integer-to-string row) ";" (integer-to-string column) "H")))))

(define! show-row
  (lambda! (row s) (move-cursor row 1) (terminal-write (control-sequence "2K") s)))

(define! show-rows
  (lambda! (row lines n)
    (when! (less-than? 0 n)
      (show-row row (if! (empty-list? lines) "" (first lines)))
      (show-rows (add row 1) (if! (empty-list? lines) () (rest lines)) (subtract n 1)))))

(define! mode-line
  (lambda! (b columns)
    (define! s
      (string-append
        (if! (evaluate-in! modified b) "-**- " "---- ")
        (evaluate-in! name b)
        (evaluate-in! mode b)
        (if! (empty-list? jobs) "" (string-append " [" (integer-to-string (length jobs)) " running]"))
        "   L" (integer-to-string (add (evaluate-in! row b) 1))
        "   C" (integer-to-string (length (evaluate-in! before b)))))
    (string-append s (spaces (subtract columns (code-point-count s))))))

(define! redisplay
  (lambda! ()
    (define! (rows columns) (terminal-size))
    (define! height (maximum 1 (subtract rows 2)))
    (define! window window-buffer)
    (define! row (evaluate-in! row window))
    ; Scroll so the current line is in the window, recentring when it leaves. Rows and height
    ; are positive, so divide rounds down.
    (when! (or!? (less-than? row (evaluate-in! top window))
                 (less-than-or-equal? (add (evaluate-in! top window) height) row))
      (bind window (quote! top) (maximum 0 (subtract row (divide height 2)))))
    (define! above-shown (subtract row (evaluate-in! top window)))
    (define! lines
      (reverse-onto (take (evaluate-in! above window) above-shown)
        (pair (buffer-line window)
              (take (evaluate-in! below window) (subtract height (add above-shown 1))))))
    (terminal-write (control-sequence "?25l"))
    (show-rows 1 lines height)
    (move-cursor (subtract rows 1) 1)
    (terminal-write (control-sequence "7m") (mode-line window columns) (control-sequence "0m"))
    (if! (empty-list? minibuffer)
      (sequence!
        (show-row rows message-text)
        (move-cursor (add above-shown 1)
                     (add (minimum (display-column (reverse (evaluate-in! before window)))
                                   (subtract columns 1))
                          1)))
      (sequence!
        (show-row rows (string-append (evaluate-in! prompt minibuffer) (buffer-line minibuffer)))
        (move-cursor rows
                     (add (display-column
                            (append (string-to-code-points (evaluate-in! prompt minibuffer))
                                    (reverse (evaluate-in! before minibuffer))))
                          1))))
    (terminal-write (control-sequence "?25h"))))

; --- Keys ---------------------------------------------------------------------------------------
; An event is a code point (an integer) for a character, or a symbol: C-a, M-x, RET, DEL, up...
; The terminal's bytes are decoded here: ESC starts a meta key or an escape sequence, and the
; bytes of a UTF-8 character are put together.

(define! control-key
  (lambda! (b)
    (conditional!
      ((same? b 13) (quote! RET))
      ((same? b 9) (quote! TAB))
      ((same? b 0) (quote! C-SPC))
      ((less-than? b 27) (string-to-symbol (string-append "C-" (code-point-to-string (add b 96)))))
      (#true (string-to-symbol (string-append "C-" (code-point-to-string (add b 64))))))))

; The code point of a UTF-8 character whose first byte is b, reading the bytes after it.
(define! decode-character
  (lambda! (b)
    (define! more
      (lambda! (n v)
        (if! (same? n 0) v (more (subtract n 1) (add (multiply v 64) (subtract (key) 128))))))
    (conditional!
      ((less-than? b 192) b)
      ((less-than? b 224) (more 1 (subtract b 192)))
      ((less-than? b 240) (more 2 (subtract b 224)))
      (#true (more 3 (subtract b 240))))))

(define! decode-byte
  (lambda! (b)
    (conditional!
      ((less-than? b 32) (control-key b))
      ((same? b 127) (quote! DEL))
      ((less-than? b 128) b)
      (#true (decode-character b)))))

; The bytes of an escape sequence after ESC [ or ESC O, up to its final byte.
(define! escape-sequences
  (list (list "A" (quote! up)) (list "B" (quote! down)) (list "C" (quote! right))
        (list "D" (quote! left)) (list "H" (quote! home)) (list "F" (quote! end))
        (list "1~" (quote! home)) (list "4~" (quote! end)) (list "3~" (quote! deletechar))
        (list "5~" (quote! prior)) (list "6~" (quote! next))))

(define! read-escape-sequence
  (lambda! (code-points)
    (define! b (key))
    (if! (and!? (less-than-or-equal? 64 b) (less-than-or-equal? b 126))
      (sequence!
        (define! s (code-points-to-string (reverse (pair b code-points))))
        (define! found (find-association s escape-sequences))
        (if! (empty-list? found)
          (string-to-symbol (string-append "ESC-[" s))
          (first (rest found))))
      (read-escape-sequence (pair b code-points)))))

(define! read-event
  (lambda! ()
    (define! b (key))
    (if! (same? b 27)
      (sequence!
        (define! second (key))
        (if! (or!? (same? second 91) (same? second 79))
          (read-escape-sequence ())
          (string-to-symbol (string-append "M-" (key-name (decode-byte second))))))
      (decode-byte b))))

(define! key-name
  (lambda! (event)
    (conditional!
      ((same? event 32) "SPC")
      ((integer? event) (code-point-to-string event))
      (#true (value-to-string event)))))

(define! key-symbol
  (lambda! (event) (if! (integer? event) (string-to-symbol (code-point-to-string event)) event)))

(define! keys-description
  (lambda! (events) (string-join (map key-name events) " ")))

; --- Keymaps ------------------------------------------------------------------------------------
; A keymap is a context binding key symbols to command names (symbols) or to keymaps (prefix
; keys). Commands are looked up by name when run, so redefining one takes effect.

(define! global-map (context))

(define! lookup-key
  (lambda! (keymap event)
    (define! k (key-symbol event))
    (if! (member? k (names keymap)) (evaluate k keymap) #false)))

; (string-to-keys "C-x C-s") is (C-x C-s).
(define! string-to-keys
  (lambda! (s)
    (map (lambda! (code-points) (string-to-symbol (code-points-to-string code-points)))
         (split-code-points (string-to-code-points s) 32))))

; (define-key keymap "C-x C-s" (quote! save-buffer))
(define! define-key
  (lambda! (keymap keys command)
    (define! walk
      (lambda! (keymap keys)
        (if! (empty-list? (rest keys))
          (bind keymap (first keys) command)
          (sequence!
            (define! sub (lookup-key keymap (first keys)))
            (when! (not? (context? sub))
              (define! sub (context))
              (bind keymap (first keys) sub))
            (walk sub (rest keys))))))
    (walk keymap (string-to-keys keys))))

(define! global-set-key (lambda! (keys command) (define-key global-map keys command)))

; --- The command loop ---------------------------------------------------------------------------

(define! last-command-event ())
(define! this-command ())
(define! last-command ())
(define! exit-flag #false)

; Runs a command. If it changed the text, the buffer's state from before goes on its undo list;
; a run of typed characters is undone as one.
(define! run-command
  (lambda! (command)
    (define! b current-buffer)
    (define! state (buffer-state b))
    (bind editor-context (quote! this-command) command)
    (bind editor-context (quote! text-changed) #false)
    (if! (symbol? command)
      (evaluate (list command) editor-context)
      (command))
    (when! (and!? text-changed
                  (not? (same? command (quote! undo)))
                  (not? (and!? (same? command (quote! self-insert-command))
                               (same? last-command (quote! self-insert-command)))))
      (bind b (quote! undo) (pair state (evaluate-in! undo b))))
    (bind editor-context (quote! text-changed) #false)
    (bind editor-context (quote! last-command) this-command)))

; Runs the key sequence that starts with `event`, looked up in `keymap`; `keys` are the events
; so far, latest first.
(define! dispatch
  (lambda! (keymap event keys)
    (define! binding (lookup-key keymap event))
    (conditional!
      ((context? binding)
       (message (string-append (keys-description (reverse keys)) "-"))
       (define! next (read-event))
       (message "")
       (when! (same? next (quote! C-g)) (raise (error (quote! quit))))
       (dispatch binding next (pair next keys)))
      ((same? binding #false)
       (if! (and!? (integer? event) (empty-list? (rest keys)))
         (run-command (quote! self-insert-command))
         (message (string-append (keys-description (reverse keys)) " is undefined"))))
      (#true (run-command binding)))))

(define! command-step
  (lambda! ()
    (define! event (read-event))
    (message "")
    (bind editor-context (quote! last-command-event) event)
    (dispatch (if! (same? (lookup-key (field! keymap) event) #false) global-map (field! keymap))
              event
              (list event))))

; Reads and runs commands until one sets exit-flag.
(define! command-loop
  (lambda! ()
    (command-step)
    (if! exit-flag (bind editor-context (quote! exit-flag) #false) (command-loop))))

; --- The minibuffer -----------------------------------------------------------------------------

(define! minibuffer-map (context))

; The buffer and minibuffer come back however the reading ends: with RET, or with an error or
; C-g that goes on to the host. A stop can cut the restore; editor-recover then finishes it.
(define! read-from-minibuffer
  (lambda! (prompt)
    (define! outer-buffer current-buffer)
    (define! outer-minibuffer minibuffer)
    (define! reading (buffer "*minibuffer*" () (list "")))
    (bind reading (quote! (keymap prompt)) (list minibuffer-map prompt))
    (bind editor-context (quote! (minibuffer current-buffer)) (list reading reading))
    (finally!
      (sequence! (command-loop) (line-string))
      (bind editor-context (quote! (current-buffer minibuffer exit-flag))
        (list outer-buffer outer-minibuffer #false)))))

(define! exit-minibuffer (lambda! () (bind editor-context (quote! exit-flag) #true)))

; --- Starting and recovering --------------------------------------------------------------------

(define! find-file-noselect
  (lambda! (file)
    (define! text (if! (empty-list? file) () (read-file file)))
    (buffer (if! (empty-list? file) "*scratch*" file) file
      (if! (empty-list? text) (list "") (text-to-lines text)))))

(define! editor-main
  (lambda! (file text)
    (bind editor-context (quote! window-buffer) (find-file-noselect file))
    (bind editor-context (quote! current-buffer) window-buffer)
    ; An empty text keeps what the init file put in the echo area.
    (when! (not? (same? text "")) (message text))))

; After an error ended a run: the error in the echo area. What it set for a while (the minibuffer)
; its finally! has put back.
(define! editor-report message)

; After an error ended the run that was reading keys, so that none is. A run that ended has no
; minibuffer open, and a stop can leave one behind, before its finally! is installed or while that
; finally! restores: start again from the window's buffer.
(define! editor-recover
  (lambda! (text)
    (bind editor-context (quote! (current-buffer minibuffer exit-flag))
      (list window-buffer () #false))
    (message text)))

; --- Commands -----------------------------------------------------------------------------------

(define! self-insert-command
  (lambda! () (define-field! before (pair last-command-event (field! before))) (set-modified)))

(define! newline
  (lambda! ()
    (define-field! above (pair (code-points-to-string (reverse (field! before))) (field! above)))
    (define-field! before ())
    (define-field! row (add (field! row) 1))
    (set-modified)))

(define! forward-char
  (lambda! ()
    (conditional!
      ((pair? (field! after))
       (define-field! before (pair (first (field! after)) (field! before)))
       (define-field! after (rest (field! after))))
      ((pair? (field! below)) (line-down 0))
      (#true (message "End of buffer")))))

(define! backward-char
  (lambda! ()
    (conditional!
      ((pair? (field! before))
       (define-field! after (pair (first (field! before)) (field! after)))
       (define-field! before (rest (field! before))))
      ((pair? (field! above)) (line-up 1000000000))
      (#true (message "Beginning of buffer")))))

; The column C-n and C-p aim for: kept while they repeat.
(define! goal-column 0)
(define! set-goal
  (lambda! ()
    (when! (not? (member? last-command (quote! (next-line previous-line))))
      (bind editor-context (quote! goal-column) (current-column)))))

(define! next-line
  (lambda! ()
    (set-goal)
    (if! (pair? (field! below)) (line-down goal-column) (message "End of buffer"))))

(define! previous-line
  (lambda! ()
    (set-goal)
    (if! (pair? (field! above)) (line-up goal-column) (message "Beginning of buffer"))))

(define! beginning-of-line
  (lambda! ()
    (define-field! after (reverse-onto (field! before) (field! after)))
    (define-field! before ())))

(define! end-of-line
  (lambda! ()
    (define-field! before (reverse-onto (field! after) (field! before)))
    (define-field! after ())))

(define! beginning-of-buffer
  (lambda! ()
    (define! lines (reverse-onto (field! above) (pair (line-string) (field! below))))
    (define-field! above ())
    (define-field! row 0)
    (define-field! below (rest lines))
    (enter-line (first lines) 0)))

(define! end-of-buffer
  (lambda! ()
    (define! lines (reverse-onto (field! below) (pair (line-string) (field! above))))
    (define-field! row (add (field! row) (length (field! below))))
    (define-field! below ())
    (define-field! above (rest lines))
    (define-field! before (reverse (string-to-code-points (first lines))))
    (define-field! after ())))

(define! delete-backward-char
  (lambda! ()
    (conditional!
      ((pair? (field! before)) (define-field! before (rest (field! before))) (set-modified))
      ((pair? (field! above))
       (define-field! before (reverse (string-to-code-points (first (field! above)))))
       (define-field! above (rest (field! above)))
       (define-field! row (subtract (field! row) 1))
       (set-modified))
      (#true (message "Beginning of buffer")))))

(define! delete-char
  (lambda! ()
    (conditional!
      ((pair? (field! after)) (define-field! after (rest (field! after))) (set-modified))
      ((pair? (field! below))
       (define-field! after (string-to-code-points (first (field! below))))
       (define-field! below (rest (field! below)))
       (set-modified))
      (#true (message "End of buffer")))))

; The last killed text, as code points (10 for a newline). Kills in a row add to it.
(define! kill-ring ())

(define! kill-line
  (lambda! ()
    (define! killed
      (conditional!
        ((pair? (field! after))
         (define! text (field! after))
         (define-field! after ())
         text)
        ((pair? (field! below))
         (define-field! after (string-to-code-points (first (field! below))))
         (define-field! below (rest (field! below)))
         (list 10))
        (#true (message "End of buffer") ())))
    (when! (pair? killed)
      (bind editor-context (quote! kill-ring)
        (if! (same? last-command (quote! kill-line)) (append kill-ring killed) killed))
      (set-modified))))

(define! insert-tab (lambda! () (insert-code-points (list 9)) (set-modified)))

(define! yank (lambda! () (insert-code-points kill-ring) (set-modified)))

(define! undo
  (lambda! ()
    (if! (empty-list? (field! undo))
      (message "No further undo information")
      (sequence!
        (define! (above before after below row) (first (field! undo)))
        (bind current-buffer (quote! (above before after below row undo))
          (list above before after below row (rest (field! undo))))
        (set-modified)
        (message "Undo")))))

(define! save-buffer
  (lambda! ()
    (when! (empty-list? (field! file))
      (define-field! file (read-from-minibuffer "File to save in: "))
      (define-field! name (field! file)))
    (write-file (field! file) (buffer-text))
    (define-field! modified #false)
    (message (string-append "Wrote " (field! file)))))

(define! save-buffers-kill-emacs
  (lambda! ()
    (when! (or!? (not? (evaluate-in! modified window-buffer))
                 (equal? (read-from-minibuffer "Modified buffer; quit anyway? (yes or no) ") "yes"))
      (quit-editor))))

; C-g reaches what you are looking at: a prompt ends, and the command whose output is in the window
; is cancelled. Any other window: the newest command, one at a time. Nothing running, it only quits.
(define! keyboard-quit
  (lambda! ()
    (define! shown (filter (lambda! (j) (same? (evaluate-in! out j) window-buffer)) jobs))
    (define! chosen
      (conditional!
        ((pair? shown) shown)
        ((any? (lambda! (b) (same? b window-buffer)) output-buffers) ())
        (#true jobs)))
    (when! (or!? (not? (empty-list? minibuffer)) (empty-list? chosen))
      (raise (error (quote! quit))))
    (quit-job (first chosen))
    (message (string-append "Cancelled " (evaluate-in! name (evaluate-in! out (first chosen)))))))

(define! recenter
  (lambda! () (terminal-write (control-sequence "2J")) (bind window-buffer (quote! top) -1000)))

(define! execute-extended-command
  (lambda! () (run-command (string-to-symbol (read-from-minibuffer "M-x ")))))

; The forms of `text` from offset `at`, read and not evaluated.
(define! read-forms
  (lambda! (text at)
    (let! ((read (read-form text at)))
      (if! (empty-list? read)
        ()
        (let! (((form #ignore end) read)) (pair form (read-forms text end)))))))

(define! eval-expression
  (lambda! ()
    (define! forms (read-forms (read-from-minibuffer "Eval: ") 0))
    (message (value-to-string (evaluate (pair (quote! sequence!) forms) editor-context)))))

; --- Shell commands -----------------------------------------------------------------------------
; A job is a record: the buffer its output goes to, the host's number for it (() until it starts)
; and its status (() until it ends).

(define! jobs ())
(define! output-buffers ())

(define! make-job
  (lambda! (out)
    (define! job (context))
    (bind job (quote! (out id status)) (list out () ()))
    job))

(define! add-job
  (lambda! (job id)
    (bind job (quote! id) id)
    (bind editor-context (quote! jobs) (pair job jobs))))

(define! job-running? (lambda! (job) (any? (lambda! (j) (same? j job)) jobs)))

(define! cancel-job
  (lambda! (job) (when! (job-running? job) (job-cancel (evaluate-in! id job)))))

; Waits for the job: the run is set aside, the host's loop goes on, and this returns when it ends.
(define! wait-for
  (lambda! (job) (when! (job-running? job) (job-wait (evaluate-in! id job)))))

; C-g's way to end a command: its command is killed and the run waiting for it is abandoned, so
; every finally! in that run goes off.
(define! quit-job
  (lambda! (job)
    (cancel-job job)
    (job-abandon (evaluate-in! id job))))

; A buffer for a command's output, one C-x b away.
(define! output-buffer
  (lambda! (command)
    (define! out (buffer (string-append "*" command "*") () (list "")))
    (bind editor-context (quote! output-buffers) (pair out output-buffers))
    (bind editor-context (quote! previous-buffer) out)
    out))

; Adds text at the end of buffer b. A point at the end stays at the end, so the window follows;
; a point elsewhere stays where it is. Only the lines at the seams become code points.
(define! append-output
  (lambda! (b text)
    (define! parts (string-split text "\n"))
    (define! head (first parts))
    (define! more (rest parts))
    (define! lines (subtract (length parts) 1))
    (if! (and!? (empty-list? (evaluate-in! below b)) (empty-list? (evaluate-in! after b)))
      (sequence!
        (define! line (reverse-onto (string-to-code-points head) (evaluate-in! before b)))
        (if! (empty-list? more)
          (bind b (quote! before) line)
          (sequence!
            (define! reversed (reverse more))
            (bind b (quote! (above before row))
              (list (append (rest reversed)
                            (pair (code-points-to-string (reverse line)) (evaluate-in! above b)))
                    (reverse (string-to-code-points (first reversed)))
                    (add (evaluate-in! row b) lines))))))
      (if! (empty-list? (evaluate-in! below b))
        (bind b (quote! (after below))
          (list (append (evaluate-in! after b) (string-to-code-points head)) more))
        (sequence!
          (define! reversed (reverse (evaluate-in! below b)))
          (bind b (quote! below)
            (reverse-onto (rest reversed)
              (pair (string-append (first reversed) head) more))))))))

(define! set-mode (lambda! (b text) (bind b (quote! mode) text)))

; What a job did, from the host: (output job text) or (ended job status).
(define! job-event
  (lambda! (event)
    (define! (what number value) event)
    (define! found (filter (lambda! (j) (same? (evaluate-in! id j) number)) jobs))
    (when! (pair? found)
      (define! job (first found))
      (if! (same? what (quote! output))
        (append-output (evaluate-in! out job) value)
        (sequence!
          (bind job (quote! status) value)
          (bind editor-context (quote! jobs)
            (filter (lambda! (j) (not? (same? j job))) jobs)))))))

; (run-shell command): runs the command, waiting for it without stopping the editor, its output
; in a buffer of its own. A temporary file and the buffer's mode last as long as it does. However
; it ends, the finally! kills what is left of it and puts those back. A status that isn't 0 is
; the error shell-failed.
(define! run-shell
  (lambda! (command)
    (define! out (output-buffer command))
    (define! lock (temporary-file))
    (define! job (make-job out))
    (finally!
      (sequence!
        (set-mode out " [running]")
        (write-file lock command)
        (add-job job (job-start command))
        (wait-for job)
        (when! (not? (member? (evaluate-in! status job) (list () 0)))
          (raise (error (quote! shell-failed) command (evaluate-in! status job)))))
      (cancel-job job)
      (delete-file lock)
      (set-mode out ""))))

; M-!: the command runs beside whatever you do next, the prompt you typed it in included.
(define! shell-command
  (lambda! ()
    (define! command (read-from-minibuffer "Shell command: "))
    (spawn (lambda! () (run-shell command)))))

; C-x j: the window goes to the next command's output, newest first, so C-g can reach that one.
(define! next-output-buffer
  (lambda! ()
    (define! after
      (lambda! (buffers)
        (conditional!
          ((empty-list? buffers) output-buffers)
          ((same? (first buffers) window-buffer)
           (if! (pair? (rest buffers)) (rest buffers) output-buffers))
          (#true (after (rest buffers))))))
    (define! back
      (if! (any? (lambda! (b) (same? b window-buffer)) output-buffers) previous-buffer window-buffer))
    (if! (empty-list? output-buffers)
      (message "No commands yet")
      (sequence!
        (switch-to (first (after output-buffers)))
        (bind editor-context (quote! previous-buffer) back)))))

; --- Help ---------------------------------------------------------------------------------------

(define! previous-buffer ())
(define! help-map (context))

; Shows `text` in the *Help* buffer, long lines broken at the window's width; q goes back.
(define! show-help
  (lambda! (text)
    (define! width (maximum 10 (first (rest (terminal-size)))))
    (define! break-line
      (lambda! (code-points)
        (if! (less-than? (length code-points) (add width 1))
          (list (code-points-to-string code-points))
          (pair (code-points-to-string (take code-points width))
                (break-line (drop code-points width))))))
    (define! lines (apply append (map break-line (split-code-points (string-to-code-points text) 10))))
    (define! help (buffer "*Help*" () lines))
    (bind help (quote! keymap) help-map)
    (switch-to help)
    (message "q to go back")))

(define! switch-to
  (lambda! (b)
    (bind editor-context (quote! previous-buffer) window-buffer)
    (bind editor-context (quote! window-buffer) b)
    (bind editor-context (quote! current-buffer) b)))

(define! other-buffer
  (lambda! ()
    (if! (empty-list? previous-buffer) (message "No other buffer") (switch-to previous-buffer))))

(define! describe-function
  (lambda! ()
    (define! name (read-from-minibuffer "Describe function: "))
    (show-help
      (string-append name " is "
                     (value-to-string (evaluate (string-to-symbol name) editor-context))))))

; The bindings of `keymap` under `prefix` (a list of key symbols), as lines.
(define! binding-lines
  (lambda! (keymap prefix)
    (apply append
      (map (lambda! (k)
             (define! binding (evaluate k keymap))
             (define! keys (append prefix (list k)))
             (if! (context? binding)
               (binding-lines binding keys)
               (sequence!
                 (define! name (keys-description keys))
                 (list (string-append name (spaces (maximum 1 (subtract 16 (code-point-count name))))
                                      (value-to-string binding))))))
           (names keymap)))))

(define! describe-bindings
  (lambda! ()
    (show-help (string-join (append (list "Key             Binding" "")
                                    (binding-lines global-map ())
                                    (list "" "In the minibuffer:")
                                    (binding-lines minibuffer-map ()))
                            "\n"))))

(define! describe-key
  (lambda! ()
    (message "Describe key: ")
    (define! describe
      (lambda! (keymap keys)
        (define! binding (lookup-key keymap (first keys)))
        (if! (context? binding)
          (describe binding (pair (read-event) keys))
          (sequence!
            (define! name (keys-description (reverse keys)))
            (if! (same? binding #false)
              (message (string-append name " is undefined"))
              (show-help (string-append name " runs " (value-to-string binding) "\n\n"
                                        (value-to-string binding) " is "
                                        (value-to-string (evaluate binding editor-context)))))))))
    (describe global-map (list (read-event)))))

; --- Bindings -----------------------------------------------------------------------------------

(global-set-key "C-f" (quote! forward-char))
(global-set-key "right" (quote! forward-char))
(global-set-key "C-b" (quote! backward-char))
(global-set-key "left" (quote! backward-char))
(global-set-key "C-n" (quote! next-line))
(global-set-key "down" (quote! next-line))
(global-set-key "C-p" (quote! previous-line))
(global-set-key "up" (quote! previous-line))
(global-set-key "C-a" (quote! beginning-of-line))
(global-set-key "home" (quote! beginning-of-line))
(global-set-key "C-e" (quote! end-of-line))
(global-set-key "end" (quote! end-of-line))
(global-set-key "M-<" (quote! beginning-of-buffer))
(global-set-key "M->" (quote! end-of-buffer))
(global-set-key "RET" (quote! newline))
(global-set-key "C-j" (quote! newline))
(global-set-key "DEL" (quote! delete-backward-char))
(global-set-key "C-d" (quote! delete-char))
(global-set-key "deletechar" (quote! delete-char))
(global-set-key "TAB" (quote! insert-tab))
(global-set-key "C-k" (quote! kill-line))
(global-set-key "C-y" (quote! yank))
(global-set-key "C-_" (quote! undo))
(global-set-key "C-x u" (quote! undo))
; C-g also stops a command that is busy (the host does), so this runs when none is.
(global-set-key "C-g" (quote! keyboard-quit))
(global-set-key "C-l" (quote! recenter))
(global-set-key "C-x C-s" (quote! save-buffer))
(global-set-key "C-x C-c" (quote! save-buffers-kill-emacs))
(global-set-key "C-x b" (quote! other-buffer))
(global-set-key "M-x" (quote! execute-extended-command))
(global-set-key "M-:" (quote! eval-expression))
(global-set-key "M-!" (quote! shell-command))
(global-set-key "C-x j" (quote! next-output-buffer))
(global-set-key "C-h f" (quote! describe-function))
(global-set-key "C-h b" (quote! describe-bindings))
(global-set-key "C-h k" (quote! describe-key))
(define-key minibuffer-map "RET" (quote! exit-minibuffer))
(define-key help-map "q" (quote! other-buffer))
