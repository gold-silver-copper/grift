; Tests that fail on purpose, each in its own way, between tests that pass: the runner's own check
; (test.sh) reads this file's report.

(test! "passes before the failures"
  (expect-equal! (add 1 1) 2))

(test! "wrong value"
  (expect-equal! (add 1 1) 3))

(test! "two wrong values, both reported"
  (expect-equal! (reverse (list 1 2 3)) (list 1 2 3))
  (expect-true! (empty-list? (list 1)))
  (expect-equal! (length (list 1 2)) 2))

(define! helper (lambda! (x) (add 1 (first x))))

(test! "a form raises, ending the test"
  (expect-equal! 1 1)
  (helper 1)
  (expect-equal! 1 2))

(test! "the expression raises, and the test goes on"
  (expect-equal! (helper 1) 2)
  (expect-equal! 1 3))

(test! "an unbound name in the test"
  (expect-equal! no-such-name 1))

(test! "raises an error of its own"
  (raise (error (quote! my-own-kind) 1 "two")))

(test! "expects an error and gets a value"
  (expect-error! type-error (add 1 1)))

(test! "expects one error and gets another"
  (expect-error! type-error (divide 1 0)))

(test! "checks nothing"
  (equal? 1 2))

(test! "calls exit"
  (exit 3)
  (expect-true! #true))

(test! "failing shows what it displayed"
  (display "seen " 42)
  (newline)
  (display "after")
  (expect-equal! 1 2))

(test! "wrong output"
  (expect-output! (display "hello") "goodbye"))

(test! "floats too far apart"
  (expect-near! (square-root 2.0) 1.5 0.001))

(test! "not-a-number is not equal to itself"
  (expect-equal! (divide 0.0 0.0) (divide 0.0 0.0)))

(test! "misused expectation"
  (expect-equal! 1))

(test! "a test can't define for the next one"
  (define! left-behind 1)
  (expect-equal! left-behind 1))

(test! "so this one sees nothing"
  (expect-false! (binds!? (current-context) left-behind)))

(test! "passes after the failures"
  (expect-equal! (add 2 2) 4))

(define! expect-even!
  (vau! (expression) caller
    (evaluate (list expect-equal! (list remainder expression 2) 0) caller)))

(test! "an expectation of the file's own, failing"
  (expect-even! (add 1 2)))

(define! make-point (lambda! (x y) (let! ((p (context))) (bind p (quote! (x y)) (list x y)) p)))

(test! "two records with the same fields"
  (expect-equal! (make-point 1 2) (make-point 1 2)))

(test! "two combiners that print alike"
  (expect-equal! (lambda! (x) x) (lambda! (x) x)))
