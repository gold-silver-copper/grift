; Testing a program: load! its definitions, then call them. Generated tests and a group's shared
; setup too.
(load! "../examples/stack.grift")

(define! stack-with
  (lambda! items
    (let! ((stack (make-stack)))
      (for-each (evaluate-in! push stack) items)
      stack)))

(group! "stack"
  (test! "pops what was pushed, last first"
    (define! stack (stack-with 1 2))
    (expect-equal! ((evaluate-in! pop stack)) 2)
    (expect-equal! ((evaluate-in! pop stack)) 1)
    (expect-equal! ((evaluate-in! size stack)) 0))
  (test! "popping nothing is an error of its own"
    (expect-error! stack-empty ((evaluate-in! pop (stack-with)))))
  (test! "what it prints"
    (expect-output! (show-stack (stack-with 1 2)) "2 1 \n"))
  (test! "what it exits with"
    (expect-equal! (catch! (stop-if-empty (stack-with)) e (evaluate-in! values e)) (list 4))
    (expect-true! (same? #inert (stop-if-empty (stack-with 1)))))
  (group! "with shared setup"
    (define! shared (stack-with 1))
    (test! "sees the group's definitions"
      (expect-equal! ((evaluate-in! size shared)) 1))
    (test! "a group nests in its name"
      (expect-true! (context? shared)))))

; test! evaluates its name, and a test's body sees where it was made: a table of cases is a loop.
(for-each
  (lambda! ((text parts))
    (test! (string-append "string-split of " (value-to-string text))
      (expect-equal! (string-split text ",") parts)))
  (quote! (("" (""))
           ("a" ("a"))
           ("a,b" ("a" "b"))
           (",," ("" "" "")))))

(test! "command-line arguments are the test's own: none"
  (expect-equal! command-line-arguments ()))

(test! "load! in a test binds in the test only"
  (load! "../examples/stack.grift")
  (expect-true! (binds? (current-context) (quote! make-stack)))
  (expect-true! (member? (quote! make-stack) (names (current-context)))))

; A computed name whose text is written further on doesn't move the lines of the forms between.
(test! (string-append "computed " "name")
  (expect-true! #true))

(test! "the form after it has its own line"
  (expect-equal! (string-append "computed " "name") "computed name"))
