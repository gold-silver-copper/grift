; A file of awkward cases for the formatter.   
(define! x    1)   ; trailing after a short form


(define! strings (list "a ; not a comment" "paren ( inside" "quote \" inside" "tab\tand \x3bb; escape" "naïve café"))
(define! dotted (pair 1 2)) (define! tail (quote! (a b . c)))
(define! numbers (list 1.5 -0.0 1e300 #infinity #-infinity #not-a-number -7 +3 () #inert #ignore #true #false))
(define! long-one (lambda! (alpha beta gamma) (if! (less-than? alpha beta) (add alpha (multiply beta gamma)) (subtract gamma (divide alpha beta)))))
(define! commented
  (lambda! (a ; the first
            b)
    ; before the body
    (add a b)
    ; last in the list
    ))
( ; right after the paren
