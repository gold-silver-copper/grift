; The runner's operations on files, standard input, output and error, processes and loading.
; main.rs evaluates this in a private child of the built-in context, where it has bound its host
; functions, `top` (the program's context), `script-path` and `command-line-arguments` by name.
; A program gets only what the `for-each` at the end binds in `top`. An operation on a file is a closure
; holding the file's number: a program reaches a file only through the context it was given, and
; can't name one by its number.

(define! reader
  (lambda! (path file)
    (record (quote! (path read-line read-all read-bytes close))
                (list path
                      (lambda! () (read-line-host file))
                      (lambda! () (read-all-host file))
                      (lambda! (count) (read-bytes-host file count))
                      (lambda! () (close-host file))))))
(define! writer
  (lambda! (path file)
    (record (quote! (path write close))
                (list path
                      (lambda! (data) (write-host file data))
                      (lambda! () (close-host file))))))
(define! standard-input (reader "standard-input" 0))
(define! standard-error (writer "standard-error" 1))
(define! standard-output (writer "standard-output" 2))
(define! open-file (lambda! (path) (reader path (open-host path))))
(define! create-file (lambda! (path) (writer path (create-host path))))
; The record of a finished process: its status, output and error output.
(define! run-process
  (lambda! (program . arguments)
    (record (quote! (status output error-output))
                (apply run-host (pair program arguments)))))
; load: the forms of a file, all read first, so nothing runs if one doesn't, then evaluated in turn
; in the caller's context, as Kernel's load does; each load reads the file again. Each combination
; knows its line in the file, so an error's trace says it.
(define! load
  (wrap (vau! (path) caller
          (for-each (lambda! (form) (evaluate form caller)) (read-forms path (read-file path))))))

; Whether `text` is a form left open, so the reader wants more of it. Only reading can say: a
; `parse-error` from running the input doesn't mean there is more to come.
(define! unfinished?
  (lambda! (text)
    (catch-kind! (sequence! (read-forms "stdin" text) #false) parse-error e
      (member? (first (evaluate-in! values e)) (quote! (unclosed-list unclosed-string))))))
; Evaluates the forms of `text` in the program's context and prints the last one's value.
(define! evaluate-and-print
  (lambda! (text)
    (let! ((forms (read-forms "stdin" text)))
      (when! (pair? forms)
        (display (value-to-string (last (map (lambda! (form) (evaluate form top)) forms))) "\n")))))
; The session at a terminal: a line at a time from standard input, which a program it runs reads
; too, until a whole input has come. The host reports what goes wrong with an input and the session
; goes on. Standard input ending inside a form is that form's error, and ends the session.
(define! session
  (lambda! (text prompt)
    (display-error prompt)
    (let! ((line (read-line-host 0))
           (text (join text line)))
      (conditional!
        ((same? line "") (read-forms "stdin" text) #inert)
        ((unfinished? text) (session text "  "))
        (#true (report-host (lambda! () (evaluate-and-print text)))
               (session "" "> "))))))

(define! here (current-context))
(for-each (lambda! (name) (bind top name (evaluate name here)))
          (quote! (display display-error read-file read-forms position environment-variable
                   wall-clock-nanoseconds elapsed-nanoseconds exit command-line-arguments
                   script-path standard-input standard-output standard-error open-file create-file
                   run-process load)))

; What main.rs calls when stdin is a terminal.
(lambda! () (session "" "> "))
