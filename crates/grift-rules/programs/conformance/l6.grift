; L6 the slice natives, each used once at least.
(define! top ((vau! () c c)))
(define! kind-of (lambda! (e) (lookup e (quote! kind) 0)))
(define! catch (lambda! (expr) (evaluate-with-handler expr top kind-of)))
(list
  (same? (add 2 3) 5) (same? (subtract 2 3) -1) (same? (multiply 4 5) 20)
  (same? (divide 7 2) 3) (same? (remainder 7 2) 1) (less-than? 1 2) (same? (less-than? 2 1) #false)
  (same? (first (pair 1 2)) 1) (same? (rest (pair 1 2)) 2)
  (same? (type-of "s") (quote! string)) (same? (type-of 1) (quote! integer))
  (same? (byte-length "abc") 3) (same? (byte-at "abc" 1) 98)
  (same? (slice "hello" 1 3) "el") (same? (join "a" "b" "c") "abc")
  (same? (search "hello" "ll" 0) 2) (same? (search "hello" "z" 0) ())
  (same? (string-to-symbol "abc") (quote! abc))
  (same? (value-to-string (list 1 "a")) "(1 \"a\")")
  (same? (first (first (read-form "(x)" 0))) (quote! x))
  (same? (catch (quote! (byte-at "abc" 5))) (quote! range-error))
  (same? (catch (quote! (add 1 "a"))) (quote! type-error))
  (same? (value-to-string (map (lambda! (x) (multiply x x)) (list 1 2 3))) "(1 4 9)")
  (same? (let! ((a 1) (b (add a 1))) b) 2)
  (same? (sequence! 1 2 3) 3)
  (same? (if! #false 1 2) 2))
