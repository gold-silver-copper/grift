; L1 reader and printer: each check is #true. Uses slice natives and the slice library only.
(define! top ((vau! () c c)))
(define! reads-as
  (lambda! (text expected) (same? (value-to-string (first (read-form text 0))) expected)))
(list
  (reads-as "42" "42")
  (reads-as "-17" "-17")
  (reads-as "1.5" "1.5")
  (reads-as "\"a\\\"b\"" "\"a\\\"b\"")
  (same? (byte-length "hé") 3)
  (same? (byte-length (first (read-form "\"éé\"" 0))) 4)
  (reads-as "foo-bar?" "foo-bar?")
  (reads-as "(1 . 2)" "(1 . 2)")
  (reads-as "(1 . (2 . ()))" "(1 2)")
  (reads-as "(a (b c) . d)" "(a (b c) . d)")
  (reads-as "#true" "#true")
  (reads-as "#false" "#false")
  (reads-as "#ignore" "#ignore")
  (reads-as "#inert" "#inert")
  (reads-as "()" "()")
  (reads-as "; a comment\n 7" "7")
  (same? (type-of (first (read-form "#bytes(1 2 3)" 0))) (quote! bytes))
  (same? (byte-at (first (read-form "#bytes(1 2 255)" 0)) 2) 255)
  (same? (type-of (quote! x)) (quote! symbol))
  (same? (type-of 1.5) (quote! float))
  (same? (first (rest (read-form "  (a b) rest" 0))) 2)
  (same? (first (rest (rest (read-form "  (a b) rest" 0)))) 7)
  (same? (read-form "   ; nothing\n" 0) ())
  (same? (evaluate-with-handler (quote! (read-form "(1 2" 0)) top (lambda! (e) (lookup e (quote! kind) 0))) (quote! parse-error))
  (same? (value-to-string (add 1.5 2.25)) "3.75"))
