;;;; 10-control.grift — binding and control forms.

;; not? (R-1RK §6.1.1): strict, like every boolean context.
($define! not? ($lambda (x) ($if x #f #t)))

;; $cond (R-1RK §5.6.1). A clause is (test . body); no clause matching
;; yields #inert. There is no `else`: use #t as the last test.
($define! %cond
  ($lambda (clauses env)
    ($if (eq? clauses ())
         #inert
         ($if (eval (caar clauses) env)
              (eval (%body (cdar clauses)) env)
              (%cond (cdr clauses) env)))))

($define! $cond ($vau clauses env (%cond clauses env)))

;; $and? and $or? (R-1RK §6.1.4, §6.1.5): operands are evaluated left to
;; right until the answer is known; the last one is in tail position.
($define! %and
  ($lambda (operands env)
    ($cond ((eq? operands ()) #t)
           ((eq? (cdr operands) ()) (eval (car operands) env))
           ((eval (car operands) env) (%and (cdr operands) env))
           (#t #f))))

($define! %or
  ($lambda (operands env)
    ($cond ((eq? operands ()) #f)
           ((eq? (cdr operands) ()) (eval (car operands) env))
           ((eval (car operands) env) #t)
           (#t (%or (cdr operands) env)))))

($define! $and? ($vau operands env (%and operands env)))
($define! $or? ($vau operands env (%or operands env)))

;; and? and or? (R-1RK §6.1.2, §6.1.3): applicatives over booleans. Every
;; argument must be a boolean.
($define! %and-values
  ($lambda (xs acc)
    ($if (eq? xs ()) acc (%and-values (cdr xs) ($if (car xs) acc #f)))))
($define! %or-values
  ($lambda (xs acc)
    ($if (eq? xs ()) acc (%or-values (cdr xs) ($if (car xs) #t acc)))))
($define! and? ($lambda xs (%and-values xs #t)))
($define! or? ($lambda xs (%or-values xs #f)))

;; $let (R-1RK §5.10.1): initializers are evaluated in the outer
;; environment; the body runs in a child binding the definiend trees.
($define! %eval-all
  ($lambda (exprs env)
    ($if (eq? exprs ()) () (cons (eval (car exprs) env) (%eval-all (cdr exprs) env)))))

($define! $let
  ($vau (bindings . body) env
    (eval (%body body)
          (environment-bind env
                            (%map1 car bindings)
                            (%eval-all (%map1 cadr bindings) env)))))

;; $let* (R-1RK §6.7.4): each binding sees the previous ones.
($define! %let*-env
  ($lambda (bindings env)
    ($if (eq? bindings ())
         (environment-bind env () ())
         (%let*-env (cdr bindings)
                    (environment-bind env (caar bindings) (eval (cadar bindings) env))))))

($define! $let*
  ($vau (bindings . body) env
    (eval (%body body) (%let*-env bindings env))))

;; $letrec (R-1RK §6.7.5): all definiends are in scope in every
;; initializer; reading one before initialization finishes is an
;; `uninitialized-binding` error.
($define! $letrec
  ($vau (bindings . body) env
    (eval (%body body)
          (environment-bind-recursive env
                                      (%map1 car bindings)
                                      (cons list (%map1 cadr bindings))))))

;; $letrec* (R-1RK §6.7.6): sequential $letrec.
($define! %letrec*-env
  ($lambda (bindings env)
    ($if (eq? bindings ())
         (environment-bind env () ())
         (%letrec*-env (cdr bindings)
                       (environment-bind-recursive env (caar bindings) (cadar bindings))))))

($define! $letrec*
  ($vau (bindings . body) env
    (eval (%body body) (%letrec*-env bindings env))))

;; The symbols for error kinds the library raises or inspects. There is no
;; quotation, so symbol data is made with string->symbol.
($define! %kind:type-error (string->symbol "type-error"))
($define! %kind:arity-error (string->symbol "arity-error"))
($define! %kind:range-error (string->symbol "range-error"))
($define! %kind:user (string->symbol "user"))
($define! %kind:unbound-symbol (string->symbol "unbound-symbol"))
($define! %kind:uninitialized-binding (string->symbol "uninitialized-binding"))
($define! %kind:no-prompt (string->symbol "no-prompt"))
($define! %kind:match-failure (string->symbol "match-failure"))
($define! %kind:contract-violation (string->symbol "contract-violation"))
($define! %kind:sigil-violation (string->symbol "sigil-violation"))

;; raise-error: deliver (k kind message irritants) to the innermost
;; error prompt, exactly as primitives do. If a handler resumes k with a
;; value, raise-error returns that value.
($define! raise-error
  ($lambda (kind message irritants)
    (with-sub-cont error-prompt
      ($lambda (k) (list k kind message irritants)))))

;; error (R-1RK has no error applicative; this follows klisp): a `user`
;; error with a message string and irritants.
($define! error
  ($lambda (message . irritants)
    (raise-error %kind:user message irritants)))

;; The sigil rule at definition time: in a definiend tree, a $-prefixed
;; symbol must be bound to an operative and any other symbol must not be.
($define! %dollar-symbol?
  ($lambda (s)
    ($let ((cs (string->list (symbol->string s))))
      ($if (%pair? cs) (eq? (car cs) #\$) #f))))

($define! %check-sigils
  ($lambda (definiend env)
    ($cond ((%symbol? definiend)
            ($if (eq? (%dollar-symbol? definiend) (%operative? (eval definiend env)))
                 #inert
                 (raise-error %kind:sigil-violation
                              ($if (%dollar-symbol? definiend)
                                   "a $-prefixed name must be bound to an operative"
                                   "an operative must be bound to a $-prefixed name")
                              (list definiend))))
           ((%pair? definiend)
            (%check-sigils (car definiend) env)
            (%check-sigils (cdr definiend) env))
           (#t #inert))))

;; $define! again, now checking the sigil rule once the definition is
;; initialized.
($define! $define!
  ($vau (definiend expr) #ignore
    (make-declaration
      ($lambda (target)
        ($let ((env (environment-bind-recursive target definiend expr)))
          (%check-sigils definiend env)
          env)))))
