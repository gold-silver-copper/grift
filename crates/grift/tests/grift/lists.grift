;;;; Lists, predicates, equality, $match.

($define! $quote ($vau (x) #ignore x))

(assert-true (pair? (cons 1 2) (list 1)))
(assert-false (pair? (cons 1 2) ()))
(assert-true (pair?))
(assert-true (null? () ()))
(assert-true (list? (list 1 2) ()))
(assert-false (list? (cons 1 2)))
(assert-true (boolean? #t #f))
(assert-true (inert? #inert))
(assert-true (ignore? #ignore))
(assert-true (combiner? car $if))
(assert-true (symbol? ($quote a)))
(assert-true (string? "s"))
(assert-true (char? #\a))
(assert-false (char? "a"))
(assert-false (string? #\a))
(assert-false (pair? "ab"))

(assert-equal (length (list 1 2 3)) 3)
(assert-equal (length ()) 0)
($assert-error type-error (length (cons 1 2)))
(assert-equal (list-tail (list 1 2 3) 1) (list 2 3))
(assert-equal (list-ref (list 1 2 3) 2) 3)
($assert-error range-error (list-ref (list 1 2 3) 3))
(assert-equal (append) ())
(assert-equal (append (list 1) (list 2) () (list 3 4)) (list 1 2 3 4))
(assert-equal (append (list 1) 2) (cons 1 2))
(assert-equal (reverse (list 1 2 3)) (list 3 2 1))
(assert-equal (map car (list (list 1) (list 2))) (list 1 2))
(assert-equal (map + (list 1 2) (list 10 20) (list 100 200)) (list 111 222))
($assert-error arity-error (map + (list 1 2) (list 1)))
(assert-equal (filter odd? (list 1 2 3 4 5)) (list 1 3 5))
(assert-equal (fold-left - 0 (list 1 2 3)) -6)
(assert-equal (fold-right cons () (list 1 2 3)) (list 1 2 3))
(assert-equal (reduce (list 1 2 3 4) * 1) 24)
(assert-equal (reduce () + 0) 0)
(assert-equal (for-each car (list (list 1))) #inert)

;; equal? is structural on pairs and strings, identity elsewhere.
(assert-true (equal? (list 1 "two" (list #\3)) (list 1 "two" (list #\3))))
(assert-false (equal? (list 1 2) (list 1 3)))
(assert-false (equal? "a" "b"))
(assert-false (equal? (list 1) "a"))
(assert-true (equal? car car))
(assert-equal (assoc "b" (list (list "a" 1) (list "b" 2))) (list "b" 2))
(assert-equal (assoc "z" (list (list "a" 1))) ())
(assert-equal (assq ($quote b) (list (list ($quote a) 1) (list ($quote b) 2))) (list ($quote b) 2))
(assert-true (member? (list 1) (list 2 (list 1))))
(assert-true (memq? ($quote x) (list ($quote y) ($quote x))))

;; Long lists: no Rust recursion anywhere.
($define! build ($lambda (n acc) ($if (=? n 0) acc (build (- n 1) (cons n acc)))))
($define! big (build 100000 ()))
(assert-equal (length big) 100000)
(assert-equal (length (map ($lambda (x) (* x 2)) big)) 100000)
(assert-true (equal? big (append big ())))

;; $match
($define! classify
  ($lambda (v)
    ($match v
      (() ($quote empty))
      ((x) (list ($quote one) x))
      ((x y . #ignore) (list ($quote many) x y))
      ((? integer? n) (list ($quote int) n))
      ((? string?) ($quote str))
      ("lit" ($quote never)))))
(assert-equal (classify ()) ($quote empty))
(assert-equal (classify (list 1)) (list ($quote one) 1))
(assert-equal (classify (list 1 2 3)) (list ($quote many) 1 2))
(assert-equal (classify 7) (list ($quote int) 7))
(assert-equal (classify "s") ($quote str))
($assert-error match-failure (classify #\c))
(assert-equal ($match (list 1 2) ((app length 2) ($quote two))) ($quote two))
(assert-equal ($match 5 (#ignore ($quote any))) ($quote any))
(assert-equal ($match (list 1 (list 2 3)) ((a (b c)) (+ a b c))) 6)
