;;;; Characters and strings.

($define! $quote ($vau (x) #ignore x))

(assert-equal (string->list "abc") (list #\a #\b #\c))
(assert-equal (list->string (list #\x #\y)) "xy")
(assert-equal (string-length "héllo") 5)
(assert-equal (string-append "ab" "" "cd") "abcd")
(assert-equal (string-append) "")
(assert-equal (string #\a #\b) "ab")
(assert-equal (string-ref "abc" 1) #\b)
($assert-error range-error (string-ref "abc" 3))
(assert-equal (substring "hello" 1 3) "el")
($assert-error range-error (substring "hello" 3 1))
(assert-true (string=? "a" "a"))
(assert-true (string<? "abc" "abd"))
(assert-true (string<? "ab" "abc"))
(assert-false (string<? "b" "a"))
(assert-true (string>=? "b" "a"))
(assert-equal (string-upcase "Hi!") "HI!")
(assert-equal (string-downcase "Hi!") "hi!")
(assert-equal (string-join (list "a" "b" "c") ", ") "a, b, c")
(assert-true (string-null? ""))
(assert-equal (symbol->string ($quote abc)) "abc")
(assert-equal (string->symbol "abc") ($quote abc))

(assert-equal (char->integer #\A) 65)
(assert-equal (integer->char 955) #\λ)
(assert-true (char=? #\a #\a))
(assert-true (char<? #\a #\b #\c))
(assert-true (char-alphabetic? #\q))
(assert-true (char-numeric? #\7))
(assert-true (char-whitespace? #\space))
(assert-equal (char-upcase #\a) #\A)
(assert-equal (digit-value #\7) 7)

(assert-equal (number->string 0) "0")
(assert-equal (number->string 1234) "1234")
(assert-equal (number->string -9223372036854775808) "-9223372036854775808")
(assert-equal (number->string 9223372036854775807) "9223372036854775807")
(assert-equal (string->number "-42") -42)
($assert-error parse-error (string->number "4x"))

;; read / write / display
(assert-equal (read "(a b . c)") (cons ($quote a) (cons ($quote b) ($quote c))))
(assert-equal (write "a\"b") "\"a\\\"b\"")
(assert-equal (display "a\"b") "a\"b")
(assert-equal (write #\space) "#\\space")
(assert-equal (write (list 1 "x" #\y #t #inert #ignore ())) "(1 \"x\" #\\y #t #inert #ignore ())")
(assert-equal (write car) "#[applicative]")
(assert-equal (write $if) "#[operative]")
(assert-equal (read (write (list "q\n" #\x41 -5))) (list "q\n" #\A -5))
($assert-error parse-error (read "'x"))
