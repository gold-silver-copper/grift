;;;; Checked integers.

(assert-equal (+) 0)
(assert-equal (+ 5) 5)
(assert-equal (+ 1 2 3 4) 10)
(assert-equal (*) 1)
(assert-equal (* 2 3 4) 24)
(assert-equal (- 10 1) 9)
(assert-equal (- 10 1 2 3) 4)
($assert-error arity-error (- 1))
($assert-error type-error (+ 1 "2"))
($assert-error type-error (+ #\1))
($assert-error overflow (+ 9223372036854775807 1))
($assert-error overflow (* 4611686018427387904 2))
($assert-error overflow (- -9223372036854775808 1))
(assert-equal (- 0 9223372036854775807) -9223372036854775807)

;; Euclidean division: 0 <= (mod n d) < |d|.
(assert-equal (div 7 2) 3)
(assert-equal (div -7 2) -4)
(assert-equal (div 7 -2) -3)
(assert-equal (div -7 -2) 4)
(assert-equal (list (mod 7 2) (mod -7 2) (mod 7 -2) (mod -7 -2)) (list 1 1 1 1))
(assert-equal (div-and-mod 17 5) (list 3 2))
(assert-equal (mod -9223372036854775808 10) 2)
(assert-equal (mod -9223372036854775808 -1) 0)
($assert-error division-by-zero (div 1 0))
($assert-error division-by-zero (mod 1 0))
($assert-error overflow (div -9223372036854775808 -1))

(assert-true (=? 1 1 1))
(assert-false (=? 1 1 2))
(assert-true (<? 1 2 3))
(assert-false (<? 1 3 2))
(assert-true (<=? 1 1 2))
(assert-true (>? 3 2 1))
(assert-true (>=? 3 3 1))
($assert-error type-error (=? 1 "1"))
($assert-error type-error (<? 1 2 "x"))
;; Every argument is checked even when the answer is already known.
($assert-error type-error (<? 2 1 "x"))
($assert-error arity-error (<? 1))

(assert-true (zero? 0 0))
(assert-true (positive? 1 2))
(assert-true (negative? -1))
(assert-true (even? 0 2 -4))
(assert-true (odd? 1 -3))
(assert-equal (abs -5) 5)
($assert-error overflow (abs -9223372036854775808))
(assert-equal (max 3 7 2) 7)
(assert-equal (min 3 7 2) 2)
(assert-equal (gcd 12 18 24) 6)
(assert-equal (gcd) 0)
(assert-equal (lcm 4 6) 12)
(assert-equal (expt 2 10) 1024)
(assert-equal (expt 3 0) 1)
($assert-error overflow (expt 2 63))
($assert-error range-error (expt 2 -1))

;; Integers are immediates: eq? compares them by value.
(assert-true (eq? 123456789 123456789))
