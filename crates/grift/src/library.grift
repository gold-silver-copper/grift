; The grift library: everything above the Rust primitives. Grift::new evaluates it, in order,
; in the ground environment; each form uses only the primitives and the forms above it.
; Section numbers are those of the Revised^-1 Report on the Kernel Programming Language
; (05-07.pdf), where each combiner is specified.

; $define! (4.9.1; primitive in Kernel). A one-shot operative receives the name unevaluated
; and binds it in its caller's environment, the ground.
(($vau (name) env
   (bind! env name
     ($vau (definiend expression) env
       (bind! env definiend (eval expression env)))))
 $define!)

; $quote (given in the rationale of 5.5.1).
($define! $quote ($vau (x) #ignore x))

; list (5.2.1).
($define! list (wrap ($vau xs #ignore xs)))

; $if (4.5.2; primitive in Kernel). select picks the expression, eval runs it as a tail call.
($define! $if
  ($vau (test consequent alternative) env
    (eval (select (eval test env) consequent alternative) env)))

; $sequence (5.1.1): each expression in turn, the last one as a tail call. `next` gets the
; value of the first expression, evaluated as its operand, and ignores it; it has no name, so it
; gets itself as an operand too.
($define! $sequence
  ((wrap ($vau (next) #ignore
     ($vau body env ($if (eq? body ()) #inert (next #inert next body env)))))
   (wrap ($vau (#ignore next body env) #ignore
     ($if (eq? (cdr body) ())
       (eval (car body) env)
       (next (eval (car body) env) next (cdr body) env))))))

; $lambda (5.3.2). A body of one expression is kept as is; several become ($sequence ...) with
; the symbol, as if written so, so printing the combiner shows the body as written.
($define! $lambda
  ($vau (formals . body) env
    (wrap (eval (list $vau formals #ignore
                  ($if ($if (eq? body ()) #f (eq? (cdr body) ()))
                    (car body)
                    (cons ($quote $sequence) body)))
                env))))

; get-current-environment (6.7.2).
($define! get-current-environment (wrap ($vau () e e)))

; not? (6.1.1).
($define! not? ($lambda (x) (select x #f #t)))

; Type predicates (4.4.1, 4.6.1, 4.6.2, 4.8.1, 12.5.1), of one value. R-1RK has no strings;
; string? is named as its other predicates are.
($define! null? ($lambda (x) (eq? x ())))
($define! pair? ($lambda (x) (eq? (type-of x) ($quote pair))))
($define! symbol? ($lambda (x) (eq? (type-of x) ($quote symbol))))
($define! string? ($lambda (x) (eq? (type-of x) ($quote string))))
($define! integer? ($lambda (x) (eq? (type-of x) ($quote integer))))
($define! environment? ($lambda (x) (eq? (type-of x) ($quote environment))))

; $and? and $or? (6.1.4, 6.1.5): left to right, the last operand as a tail call. Each walks its
; operands with a loop of its own, evaluating them in the caller's environment.
($define! $and?
  (($lambda ()
     ($define! all
       ($lambda (xs env)
         ($if (eq? xs ()) #t
           ($if (eq? (cdr xs) ()) (eval (car xs) env)
             ($if (eval (car xs) env) (all (cdr xs) env) #f)))))
     ($vau xs env (all xs env)))))

($define! $or?
  (($lambda ()
     ($define! any
       ($lambda (xs env)
         ($if (eq? xs ()) #f
           ($if (eq? (cdr xs) ()) (eval (car xs) env)
             ($if (eval (car xs) env) #t (any (cdr xs) env))))))
     ($vau xs env (any xs env)))))

; =? (12.5.2), of two integers: neither is less than the other.
($define! =? ($lambda (a b) ($and? (not? (<? a b)) (not? (<? b a)))))

; min and max (12.5.13), of two integers.
($define! min ($lambda (a b) ($if (<? b a) b a)))
($define! max ($lambda (a b) ($if (<? a b) b a)))

; apply (5.5.1), its two-operand form: the underlying combiner sees a new empty environment.
($define! apply
  ($lambda (applicative args)
    (eval (cons (unwrap applicative) args) (make-environment))))

; map (5.9.1), over one list.
($define! map
  ($lambda (f xs)
    ($if (eq? xs ())
      ()
      (cons (apply f (list (car xs))) (map f (cdr xs))))))

; for-each (6.9.1), over one list: f on each element in turn, for its effect.
($define! for-each
  ($lambda (f xs)
    ($if (eq? xs ())
      #inert
      ($sequence (apply f (list (car xs))) (for-each f (cdr xs))))))

; The forms with a body: $cond (5.6.1), $when, $let (5.10.1), $let* (6.7.4) and
; $unwind-protect. Each is an operative that walks its operands with car and cdr and evaluates
; only them, in the caller's environment or one it made; none builds code to evaluate. They
; share `run`, which evaluates the forms of a body in turn, the last as a tail call.
($define! ($cond $when $let $let* $unwind-protect)
  (($lambda ()
     ($define! run
       ($lambda (body env)
         ($if (eq? body ()) #inert
           ($if (eq? (cdr body) ()) (eval (car body) env)
             ($sequence (eval (car body) env) (run (cdr body) env))))))
     ($define! first-true
       ($lambda (clauses env)
         ($if (eq? clauses ()) #inert
           ($if (eval (car (car clauses)) env)
             (run (cdr (car clauses)) env)
             (first-true (cdr clauses) env)))))
     ; local, after matching formals to value in it.
     ($define! bound ($lambda (local formals value) ($sequence (bind! local formals value) local)))
     ; $let evaluates every expression in the caller's environment, then matches all the formals
     ; at once in a new child of it, so a symbol bound twice is an error, as in Kernel.
     ($define! bound-all
       ($lambda (bindings env local formals values)
         ($if (eq? bindings ())
           (bound local formals values)
           (bound-all (cdr bindings) env local
             (cons (car (car bindings)) formals)
             (cons (eval (car (cdr (car bindings))) env) values)))))
     ; $let* matches each binding in a new child of the environment before it, so each sees the
     ; ones before it.
     ($define! nested
       ($lambda (bindings body env)
         ($if (eq? bindings ())
           (run body (make-environment env))
           (nested (cdr bindings) body
             (bound (make-environment env) (car (car bindings))
               (eval (car (cdr (car bindings))) env))))))
     (list
       ; $cond: the body of the first true test; #inert if none is true, as in Kernel.
       ($vau clauses env (first-true clauses env))
       ; $when (not in Kernel): the body if the test is true, else #inert.
       ($vau (test . body) env ($if (eval test env) (run body env) #inert))
       ($vau (bindings . body) env (run body (bound-all bindings env (make-environment env) () ())))
       ($vau (bindings . body) env (nested bindings body env))
       ; $unwind-protect: the body's value, after the cleanup forms have run. They run also
       ; when an error leaves the body, and the error then goes on unchanged.
       ($vau (body . cleanup) env
         (eval-protected body env (wrap ($vau () #ignore (run cleanup env)))))))))

; $set! (6.8.1): matches formals to the value in the environment `target` evaluates to, as
; $define! does in the current one.
($define! $set!
  ($vau (target formals value) env
    (bind! (eval target env) formals (eval value env))))

; length (6.3.1), of a proper list, counting in a loop.
($define! length
  ($lambda (xs)
    ($define! count ($lambda (xs n) ($if (eq? xs ()) n (count (cdr xs) (+ n 1)))))
    (count xs 0)))

; append (6.3.3): every list but the last is copied; the last is shared.
($define! append
  ($lambda lists
    ($define! append2
      ($lambda (xs ys) ($if (eq? xs ()) ys (cons (car xs) (append2 (cdr xs) ys)))))
    ($cond ((eq? lists ()) ())
           ((eq? (cdr lists) ()) (car lists))
           (#t (append2 (car lists) (apply append (cdr lists)))))))

; reverse (not in Kernel): a list's elements in the opposite order.
($define! reverse
  ($lambda (xs)
    ($define! onto ($lambda (xs acc) ($if (eq? xs ()) acc (onto (cdr xs) (cons (car xs) acc)))))
    (onto xs ())))

; equal? (6.6.1): pairs compare by structure, everything else with eq?.
($define! equal?
  ($lambda (a b)
    ($if ($and? (pair? a) (pair? b))
      ($and? (equal? (car a) (car b)) (equal? (cdr a) (cdr b)))
      (eq? a b))))

; assoc (6.3.6): the first pair in alist whose car is equal? to x, or () if there is none.
($define! assoc
  ($lambda (x alist)
    ($cond ((eq? alist ()) ())
           ((equal? x (car (car alist))) (car alist))
           (#t (assoc x (cdr alist))))))

; member? (6.3.7): whether x is equal? to an element of xs.
($define! member?
  ($lambda (x xs)
    ($cond ((eq? xs ()) #f)
           ((equal? x (car xs)) #t)
           (#t (member? x (cdr xs))))))

; $binds? (6.7.1): whether each symbol is bound in the environment `e` evaluates to. As R-1RK
; derives it, it looks each one up, and a guard turns the error `unbound-symbol` into #f.
($define! $binds?
  (($lambda ()
     ($define! look-up
       ($lambda (e symbols)
         ($if (eq? symbols ())
           #t
           ($sequence
             ($if (symbol? (car symbols)) (eval (car symbols) e) (error ($quote type-error) (car symbols)))
             (look-up e (cdr symbols))))))
     ($define! unbound
       ($lambda (e) ($if (eq? (car e) ($quote unbound-symbol)) #f (raise e))))
     ($vau (e . symbols) env
       ($let ((e (eval e env)))
         (guard (wrap ($vau () #ignore (look-up e symbols))) unbound))))))

; Not in Kernel: the names bound here, the primitives' and this library's, so a program can
; list them. The ground itself stays out of reach, so no program can change what the library
; uses. Bound first, so that the list names itself.
($define! ground-names ())
($define! ground-names (bindings (get-current-environment)))
