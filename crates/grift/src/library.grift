; The grift library: everything above the Rust primitives. Grift::new evaluates it, in order,
; in the built-in context; each form uses only the primitives and the forms above it. Section
; numbers are those of the Revised^-1 Report on the Kernel Programming Language (05-07.pdf),
; where Kernel specifies the combiner a form here follows. By convention an operative's context
; parameter is `caller`.

; vau! (4.10.3, $vau). Every primitive starts wrapped; this one takes its operands as written. A
; one-shot operative receives the name unevaluated and binds it in its caller's context, the
; built-in one.
(((unwrap vau!) (name) caller (bind caller name (unwrap vau!))) vau!)

; define! (4.9.1, $define!; primitive in Kernel), bound the same way.
((vau! (name) caller
   (bind caller name
     (vau! (parameters expression) caller
       (bind caller parameters (evaluate expression caller)))))
 define!)

; quote! (given in the rationale of 5.5.1, $quote).
(define! quote! (vau! (x) #ignore x))

; list (5.2.1).
(define! list (wrap (vau! xs #ignore xs)))

; if! (4.5.2, $if; primitive in Kernel). Both branches are required, as in Kernel: select picks
; the expression and evaluate runs it as a tail call. One branch is when!, below.
(define! if!
  (vau! (test consequent alternative) caller
    (evaluate (select (evaluate test caller) consequent alternative) caller)))

; lambda! (5.3.2, $lambda).
(define! lambda!
  (vau! (parameters . body) caller
    (wrap (evaluate (pair vau! (pair parameters (pair #ignore body))) caller))))

; The forms with a body: sequence! (5.1.1, $sequence), when! (not in Kernel), conditional! (5.6.1,
; $cond), let! (6.7.6, $letrec*), finally!, catch! and catch-kind!; and record, which shares a helper with them. Each form is an
; operative that walks its operands and evaluates only them, in the caller's context or one it made;
; none builds code to evaluate. A loop that evaluates something only for its effect gets its value as
; an ignored first operand, and a list known not to be empty is taken apart in the parameters.
(define! (sequence! when! conditional! let! finally! catch! catch-kind! record)
  ((lambda! ()
     ; The forms of a body in turn, the last as a tail call; called only with a form left.
     (define! forms
       (lambda! (#ignore (form . more) c)
         (if! (same? more ()) (evaluate form c) (forms (evaluate form c) more c))))
     ; A body: its forms, #inert for none.
     (define! run (lambda! (body c) (if! (same? body ()) #inert (forms #inert body c))))
     ; The body of the first clause whose test is #true, or #inert; called only with a clause
     ; left, so a clause that isn't a pair (test . body) is an arity-error.
     (define! first-true
       (lambda! (((test . body) . more) caller)
         (if! (evaluate test caller)
           (run body caller)
           (if! (same? more ()) #inert (first-true more caller)))))
     ; The context `local` with each binding in order; called only with a binding left, so one
     ; that isn't (parameters expression) is an arity-error.
     (define! bind-each
       (lambda! (#ignore ((parameters expression) . more) local)
         ((if! (same? more ()) done bind-each)
          (bind local parameters (evaluate expression local))
          more
          local)))
     (define! done (lambda! (#ignore #ignore local) local))
     ; The context c, with the values bound to the names there.
     (define! filled (lambda! (c names values) (done (bind c names values) #ignore c)))
     ; A caught error's handler forms, with the parameter bound in local, a new child of the
     ; caller's context.
     (define! handle
       (lambda! (e parameter handler local) (run handler (filled local parameter e))))
     (list
       ; sequence!: each in turn, the last one's value; #inert for none.
       (vau! body caller (run body caller))
       ; when!: the body if the test is #true, #inert if it is #false.
       (vau! (test . body) caller (if! (evaluate test caller) (run body caller) #inert))
       ; conditional!: the body of the first true test; #inert if none is true, as in Kernel.
       (vau! clauses caller (if! (same? clauses ()) #inert (first-true clauses caller)))
       ; let!: one new child of the caller's context; each binding in order evaluates its
       ; expression there and binds its parameters there, so it sees the ones before it and a
       ; combiner it binds can call itself and the ones after it.
       (vau! (bindings . body) caller
         (run body
              (if! (same? bindings ())
                (context caller)
                (bind-each #inert bindings (context caller)))))
       ; finally!: the body's value, after the cleanup forms have run. They run also when an
       ; error leaves the body, and the error then goes on, unless one of them raises its own.
       (vau! (body . cleanup) caller
         (evaluate-with-cleanup body caller (wrap (vau! () #ignore (run cleanup caller)))))
       ; catch!: the body's value; if an error leaves it, the cleanups inside run first, then
       ; the handler forms. What the host or the machine began is never caught, whatever its kind.
       (vau! (body parameter . handler) caller
         (evaluate-with-handler body caller (wrap (vau! (e) #ignore (handle e parameter handler (context caller))))))
       ; catch-kind!: catch!, for the errors of one kind, a symbol; any other goes on as it was,
       ; with its trace. It names symbol? and the forms after it, which exist when it runs.
       (vau! (body wanted parameter . handler) caller
         (if! (symbol? wanted)
           (evaluate-with-handler body caller
             (wrap (vau! (e) #ignore
                     (if! (same? (evaluate-in! kind e) wanted)
                       (handle e parameter handler (context caller))
                       (raise e)))))
           (raise (error (quote! type-error) wanted))))
       ; record (not in Kernel): a new context with no parent, the values bound to the names. It
       ; branches on nothing, so the natives' definitions can stand on it.
       (lambda! (names values) (filled (context ()) names values))))))

; current-context (6.7.2, get-current-environment).
(define! current-context (wrap (vau! () caller caller)))

; evaluate-in! (6.7.9, $remote-eval): evaluates o, as a tail call, in the context c evaluates
; to. It reads a record, such as an error: (evaluate-in! kind e).
(define! evaluate-in! (vau! (o c) caller (evaluate o (evaluate c caller))))

; not? (6.1.1).
(define! not? (lambda! (x) (select x #false #true)))

; Type predicates (4.4.1, 4.6.1, 4.6.2, 4.8.1, 12.5.1), of one value: one for each type type-of
; gives.
(define! empty-list? (lambda! (x) (same? x ())))
(define! inert? (lambda! (x) (same? x #inert)))
(define! ignore? (lambda! (x) (same? x #ignore)))
(define! boolean? (lambda! (x) (same? (type-of x) (quote! boolean))))
(define! integer? (lambda! (x) (same? (type-of x) (quote! integer))))
(define! float? (lambda! (x) (same? (type-of x) (quote! float))))
(define! symbol? (lambda! (x) (same? (type-of x) (quote! symbol))))
(define! pair? (lambda! (x) (same? (type-of x) (quote! pair))))
(define! string? (lambda! (x) (same? (type-of x) (quote! string))))
(define! bytes? (lambda! (x) (same? (type-of x) (quote! bytes))))
(define! context? (lambda! (x) (same? (type-of x) (quote! context))))
(define! operative? (lambda! (x) (same? (type-of x) (quote! operative))))
(define! applicative? (lambda! (x) (same? (type-of x) (quote! applicative))))

; and!? and or!? (6.1.4, 6.1.5, $and? and $or?): left to right, stopping early. Every operand
; evaluated must give a boolean, the last one included, so it isn't a tail call.
(define! (and!? or!?)
  ((lambda! ()
     (define! all
       (lambda! ((x . more) caller)
         (if! (evaluate x caller) (if! (same? more ()) #true (all more caller)) #false)))
     (define! any
       (lambda! ((x . more) caller)
         (if! (evaluate x caller) #true (if! (same? more ()) #false (any more caller)))))
     (list (vau! xs caller (if! (same? xs ()) #true (all xs caller)))
           (vau! xs caller (if! (same? xs ()) #false (any xs caller)))))))

; apply (5.5.1), its two-operand form: the underlying combiner sees a new empty context.
(define! apply
  (lambda! (applicative arguments)
    (evaluate (pair (unwrap applicative) arguments) (context ()))))

; any? and all? (not in Kernel): whether f gives #true for some element, for every element,
; stopping early.
(define! any?
  (lambda! (f xs)
    (if! (same? xs ()) #false (if! (apply f (list (first xs))) #true (any? f (rest xs))))))
(define! all?
  (lambda! (f xs)
    (if! (same? xs ()) #true (if! (apply f (list (first xs))) (all? f (rest xs)) #false))))

; map (5.9.1): f on each element of one list, or on the elements at each place of several lists
; of one length. Lists of different lengths are an error, as in Kernel: first fails on the short one.
(define! map
  ((lambda! ()
     (define! each
       (lambda! (f xs)
         (if! (same? xs ()) () (pair (apply f (list (first xs))) (each f (rest xs))))))
     (define! across
       (lambda! (f lists)
         (if! (all? empty-list? lists)
           ()
           (pair (apply f (each first lists)) (across f (each rest lists))))))
     (lambda! (f xs . more)
       (if! (same? more ()) (each f xs) (across f (pair xs more)))))))

; for-each (6.9.1), over one list: f on each element in turn, for its effect.
(define! for-each
  (lambda! (f xs)
    (if! (same? xs ())
      #inert
      (sequence! (apply f (list (first xs))) (for-each f (rest xs))))))

; error (not in Kernel): a new error, a context with no parent binding kind, values and an empty
; trace. raise raises it, and gives it where it happened.
(define! error
  (lambda! (kind . values) (record (quote! (kind values trace)) (list kind values ()))))

; length (6.3.1), of a proper list, counting in a loop.
(define! length
  ((lambda! ()
     (define! count (lambda! (xs n) (if! (same? xs ()) n (count (rest xs) (add n 1)))))
     (lambda! (xs) (count xs 0)))))

; append (6.3.3): every list but the last is copied; the last is shared.
(define! append
  ((lambda! ()
     (define! onto
       (lambda! (xs ys) (if! (same? xs ()) ys (pair (first xs) (onto (rest xs) ys)))))
     (define! all
       (lambda! ((xs . more))
         (if! (same? more ()) xs (onto xs (all more)))))
     (lambda! lists (if! (same? lists ()) () (all lists))))))

; reverse (not in Kernel): a list's elements in the opposite order.
(define! reverse
  ((lambda! ()
     (define! onto
       (lambda! (xs done) (if! (same? xs ()) done (onto (rest xs) (pair (first xs) done)))))
     (lambda! (xs) (onto xs ())))))

; equal? (6.6.1): pairs compare by structure, the rest of a list as a tail call; floats as
; IEEE does; everything else with same?. Values of different types are never equal.
(define! equal?
  ((lambda! ()
     ; Not-a-number, the one float neither less than 1.0 nor more than 0.0, is equal to nothing.
     (define! number? (lambda! (x) (if! (less-than? x 1.0) #true (less-than? 0.0 x))))
     (define! equal-floats?
       (lambda! (a b)
         (if! (less-than? a b)
           #false
           (if! (less-than? b a) #false (if! (number? a) (number? b) #false)))))
     (lambda! (a b)
       (if! (pair? a)
         (if! (pair? b) (if! (equal? (first a) (first b)) (equal? (rest a) (rest b)) #false) #false)
         (if! (float? a)
           (if! (float? b) (equal-floats? a b) #false)
           (same? a b)))))))

; The comparisons above less-than? (12.5.3, Kernel's <? and the rest), of two values of one kind
; it orders; mixing kinds is a type-error, as it is for less-than?.
(define! greater-than? (lambda! (a b) (less-than? b a)))
(define! less-than-or-equal? (lambda! (a b) (if! (less-than? a b) #true (equal? a b))))
(define! greater-than-or-equal? (lambda! (a b) (less-than-or-equal? b a)))

; minimum and maximum (12.5.13, min and max), of two values of one kind less-than? orders.
(define! minimum (lambda! (a b) (if! (less-than? b a) b a)))
(define! maximum (lambda! (a b) (if! (less-than? a b) b a)))

; absolute-value and power (12.5.12, abs; 12.9.6, expt), of integers or floats, as add is: Rust's
; checked abs and pow on integers, abs and powf on floats. The most negative integer has no
; absolute value, and an integer power with a negative exponent isn't an integer (Rust's pow takes
; a u32): the arithmetic's overflow, a range-error.
(define! (absolute-value power)
  ((lambda! (float-absolute float-power)
     ; product times base to the exponent, by squaring; base is squared only while a bit of the
     ; exponent is left, so nothing overflows unless the result does.
     (define! raised
       (lambda! (product base exponent)
         (if! (same? exponent 0)
           product
           (power-of (if! (same? (remainder exponent 2) 0) product (multiply product base))
                     base
                     (divide exponent 2)))))
     (define! power-of
       (lambda! (product base exponent)
         (if! (same? exponent 0) product (raised product (multiply base base) exponent))))
     (list
       (lambda! (x)
         (if! (integer? x) (if! (less-than? x 0) (subtract 0 x) x) (float-absolute x)))
       (lambda! (x y)
         (if! (and!? (integer? x) (integer? y))
           (if! (less-than? y 0)
             (raise (error (quote! range-error) x y))
             (raised 1 x y))
           (float-power x y)))))
   absolute-value
   power))

; find-association (6.3.6, assoc): the first pair in the list whose first is equal? to x, or ()
; if there is none.
(define! find-association
  (lambda! (x pairs)
    (if! (same? pairs ())
      ()
      (if! (equal? x (first (first pairs)))
        (first pairs)
        (find-association x (rest pairs))))))

; member? (6.3.7): whether x is equal? to an element of xs.
(define! member?
  (lambda! (x xs)
    (if! (same? xs ())
      #false
      (if! (equal? x (first xs)) #true (member? x (rest xs))))))

; binds? (6.7.1, $binds?, with both operands evaluated, so the symbol can be computed): whether
; the symbol is bound in the context or one of its parents, that is, whether lookup finds it
; rather than giving a context no program holds.
(define! binds?
  ((lambda! (absent)
     (lambda! (c symbol) (not? (same? (lookup c symbol absent) absent))))
   (context ())))

; bindings: a context's own bindings as data, (name value) for each, sorted by name as names is,
; so a record's fields are a list a program reads with find-association and second.
(define! bindings (lambda! (c) (map (lambda! (name) (list name (evaluate name c))) (names c))))

; symbol-to-string, float-to-string: the printer's text, refusing any other type.
(define! (symbol-to-string float-to-string)
  ((lambda! ()
     (define! printing
       (lambda! (type?)
         (lambda! (x)
           (if! (type? x) (value-to-string x) (raise (error (quote! type-error) x))))))
     (list (printing symbol?) (printing float?)))))

; filter (6.3.5), and, not in Kernel, fold, range, sort and the list access below.
(define! filter
  (lambda! (f xs)
    (if! (same? xs ())
      ()
      (if! (apply f (list (first xs)))
        (pair (first xs) (filter f (rest xs)))
        (filter f (rest xs))))))
; fold: f on the value so far and each element in turn, from the left, as Rust's Iterator::fold.
(define! fold
  (lambda! (f value xs)
    (if! (same? xs ()) value (fold f (apply f (list value (first xs))) (rest xs)))))
; range: the integers from start up to, not including, end, as Rust's start..end.
(define! range
  (lambda! (start end)
    (if! (less-than? start end) (pair start (range (add start 1) end)) ())))

; sort: the elements in the order before? gives, stable: an element goes before an earlier one
; only if it is before? it, so equal ones keep their order. A merge sort: n log n calls of before?.
(define! sort
  ((lambda! ()
     (define! merge
       (lambda! (xs ys before?)
         (if! (same? xs ())
           ys
           (if! (same? ys ())
             xs
             (if! (apply before? (list (first ys) (first xs)))
               (pair (first ys) (merge xs (rest ys) before?))
               (pair (first xs) (merge (rest xs) ys before?)))))))
     ; The first n elements of xs sorted, paired with the elements after them; n is at least 1.
     (define! sorted
       (lambda! (xs n before?)
         (if! (same? n 1)
           (pair (list (first xs)) (rest xs))
           (let! ((half (divide n 2))
                  ((left . more) (sorted xs half before?))
                  ((right . after) (sorted more (subtract n half) before?)))
             (pair (merge left right before?) after)))))
     (lambda! (xs before?)
       (if! (same? xs ()) () (first (sorted xs (length xs) before?)))))))

; element-at, second, third, last, take and drop: an index counts from 0, as in Rust, and one
; out of range is a range-error carrying the operands, the list and the index or count.
(define! (element-at second third last take drop)
  ((lambda! ()
     ; The list after its first n elements, checked: the one walk the others stand on.
     (define! after
       (lambda! (xs n)
         (if! (integer? n)
           (if! (less-than? n 0) (raise (error (quote! range-error) xs n)) (walk xs n xs n))
           (raise (error (quote! type-error) n)))))
     (define! walk
       (lambda! (given n xs i)
         (if! (same? i 0)
           xs
           (if! (same? xs ())
             (raise (error (quote! range-error) given n))
             (walk given n (rest xs) (subtract i 1))))))
     (define! at
       (lambda! (xs n)
         (let! ((more (after xs n)))
           (if! (same? more ()) (raise (error (quote! range-error) xs n)) (first more)))))
     (define! final (lambda! (xs) (if! (same? (rest xs) ()) (first xs) (final (rest xs)))))
     ; The first n elements, once after has checked there are n.
     (define! taken
       (lambda! (xs n) (if! (same? n 0) () (pair (first xs) (taken (rest xs) (subtract n 1))))))
     (list at
           (lambda! (xs) (at xs 1))
           (lambda! (xs) (at xs 2))
           (lambda! (xs) (if! (same? xs ()) (raise (error (quote! range-error) xs)) (final xs)))
           (lambda! (xs n) (sequence! (after xs n) (taken xs n)))
           after))))

; The string helpers, over byte-at. Offsets and widths count bytes, as
; everywhere; a valid pattern only matches on character boundaries.
(define! (string-starts-with? string-ends-with? string-split)
  ((lambda! ()
     (define! matches?
       (lambda! (text at pattern i size)
         (if! (same? i size)
           #true
           (if! (same? (byte-at text (add at i)) (byte-at pattern i))
             (matches? text at pattern (add i 1) size)
             #false))))
     (define! pieces
       (lambda! (text separator from at)
         (if! (same? at ())
           (list (slice text from (byte-length text)))
           (let! ((next (add at (byte-length separator))))
             (pair (slice text from at)
                   (pieces text separator next (search text separator next)))))))
     (list
       (lambda! (text prefix)
         (let! ((size (byte-length prefix)))
           (and!? (not? (less-than? (byte-length text) size))
                  (matches? text 0 prefix 0 size))))
       (lambda! (text suffix)
         (let! ((size (byte-length suffix))
                (at (subtract (byte-length text) size)))
           (and!? (not? (less-than? at 0)) (matches? text at suffix 0 size))))
       ; string-split: the parts between the separators, empty ones too; string-join undoes it. An
       ; empty separator is a range-error.
       (lambda! (text separator)
         (if! (same? separator "")
           (raise (error (quote! range-error) separator))
           (pieces text separator 0 (search text separator 0))))))))

; string-join: the strings with the separator between them.
(define! string-join
  ((lambda! ()
     (define! between
       (lambda! (xs separator)
         (if! (same? xs ())
           ()
           (pair separator (pair (first xs) (between (rest xs) separator))))))
     (lambda! (strings separator)
       (if! (same? strings ()) "" (apply join (rest (between strings separator))))))))

; string-trim: without the ASCII whitespace at either end, as Rust's trim_ascii.
(define! string-trim
  ((lambda! ()
     (define! blank?
       (lambda! (b) (or!? (same? b 32) (same? b 10) (same? b 9) (same? b 13) (same? b 12))))
     (define! start-of
       (lambda! (s at end)
         (if! (and!? (less-than? at end) (blank? (byte-at s at))) (start-of s (add at 1) end) at)))
     (define! end-of
       (lambda! (s start at)
         (if! (and!? (less-than? start at) (blank? (byte-at s (subtract at 1))))
           (end-of s start (subtract at 1))
           at)))
     (lambda! (s)
       (let! ((end (byte-length s)) (start (start-of s 0 end)))
         (slice s start (end-of s start end)))))))

; string-repeat: s count times; a count below 1 is no copies.
(define! string-repeat
  (lambda! (s count) (apply join (pair "" (map (lambda! (#ignore) s) (range 0 count))))))

; string-pad-left and string-pad-right: s with copies of fill, a string of one byte, before it,
; after it, up to width bytes.
(define! (string-pad-left string-pad-right)
  ((lambda! ()
     (define! room
       (lambda! (s width fill)
         (if! (same? (byte-length fill) 1)
           (apply join (map (lambda! (#ignore) fill) (range (byte-length s) width)))
           (raise (error (quote! range-error) fill)))))
     (list (lambda! (s width fill) (join (room s width fill) s))
           (lambda! (s width fill) (join s (room s width fill)))))))

; string-to-lowercase: with A to Z made a to z, and every other byte as it is, as Rust's
; to_ascii_lowercase.
(define! string-to-lowercase
  ((lambda! ()
     (define! parts
       (lambda! (s from at end)
         (if! (same? at end)
           (list (slice s from end))
           (let! ((byte (byte-at s at)) (next (add at 1)))
             (if! (and!? (less-than? 64 byte) (less-than? byte 91))
               (pair (slice s from at)
                     (pair (code-point-to-string (add byte 32)) (parts s next next end)))
               (parts s from next end))))))
     (lambda! (s) (apply join (parts s 0 0 (byte-length s)))))))

; standard-context (6.7.7, make-kernel-standard-environment): a new child of the built-in context,
; which sees the language and nothing of any program. The context itself stays out of reach.
(define! standard-context
  ((lambda! (built-in) (lambda! () (context built-in))) (current-context)))

; Not in Kernel: the names bound here, the primitives' and this library's, so a program can
; list them. The built-in context itself stays out of reach, so no program can change what the
; library uses. Bound first, so that the list names itself.
(define! built-in-names ())
(define! built-in-names (names (current-context)))
